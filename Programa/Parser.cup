/* ============================================================
                    SÍMBOLO INICIAL
   ============================================================ */

start with programa;

/* ============================================================
                        VALORES
   ============================================================ */

bool ::= TRUE   {: RESULT = new Atrib("bool", "true"); :}
      | FALSE  {: RESULT = new Atrib("bool", "false"); :} ;

tipo ::= INT     {: RESULT = "int";    :}
      | FLOAT   {: RESULT = "float";  :}
      | BOOL    {: RESULT = "bool";   :}
      | CHAR    {: RESULT = "char";   :}
      | STRING  {: RESULT = "string"; :};

valor_numerico ::= entero:e    {: RESULT = e;  :}
              | flotante:f  {: RESULT = f;  :} ;

entero ::= LITERAL_INT:v
        {: Atrib a = new Atrib("int", String.valueOf(v));
          a.valor = parser.aEntero(a.lugar);
          RESULT = a; :} ;

flotante ::= LITERAL_FLOAT :v
        {: RESULT = new Atrib("float", String.valueOf(v)); :} ;

cadena_texto ::= LITERAL_STRING :v
        {: RESULT = new Atrib("string", String.valueOf(v)); :} ;

caracter_literal ::= LITERAL_CHAR :v
        {: RESULT = new Atrib("char", String.valueOf(v)); :} ;


/* ============================================================
                IDENTIFICADORES
   ============================================================ */

identificador ::= ID:id  {: RESULT = id; :} ;

/* ============================================================
                DELIMITADORES Y OPERADORES
   ============================================================ */

/* TS: ¿: abre un ámbito nuevo y :? lo cierra */
abrir_bloque  ::= OPBLOCK  {: parser.tabla.abrirAmbito();  :} ;

cerrar_bloque ::= CLBLOCK  {: parser.tabla.cerrarAmbito(); :} ;

abrir_corcheteCuadrados ::= OPBRACKET ;

cerrar_corcheteCuadrados ::= CLBRACKET ;

coma ::= COMA ;

fin_sentencia ::= TERMINATOR ;

asignacion ::= ASIGN ;

incremento ::= INCREMENT ;

decremento ::= DECREMENT ;


/* ============================================================
                PALABRAS RESERVADAS
   ============================================================ */

palabraVal ::= VAL ;

palabraBreak ::= BREAK ;

palabraReturn ::= RETURN ;

palabraPrint ::= PRINT ;

/* TS: cada palabra le pone nombre al ámbito de su bloque */
/* TS: principal se registra como procedimiento sin parámetros */
Principal   ::= PRINCIPAL:p  {: parser.tabla.declararFuncion("principal", "void", null, pleft, pright); :} ;

palabraIf   ::= IF         {: parser.tabla.siguienteAmbito("if");    :} ;

palabraElif ::= ELIF       {: parser.tabla.siguienteAmbito("elif");  :} ;

palabraElse ::= ELSE       {: parser.tabla.siguienteAmbito("else");  :} ;

palabraWhile ::= WHILE     {: parser.tabla.siguienteAmbito("while"); :} ;

/* TS: el for abre su ámbito desde el inicio, porque la variable de
   control (val int x Ͱ 9) se declara antes del ¿: */
palabraFor  ::= FOR        {: parser.tabla.abrirAmbito("for");
                              parser.tabla.siguienteAmbito("cuerpo for"); :} ;

operadorPotencia ::= POT ;

leer ::= READ ;

escribir ::= WRITE ;


/* ============================================================
                        VARIABLES
  TS: se declara la variable.
  SEM: si lleva valor inicial, se comprueba que el tipo del valor
        coincida con el tipo de la variable (parser.asignar).
   ============================================================ */

def_variable ::=
      palabraVal INT    identificador:id fin_sentencia
      {: parser.tabla.declararVariable(id, "int", null, idleft, idright); :}
    | palabraVal FLOAT  identificador:id fin_sentencia
      {: parser.tabla.declararVariable(id, "float", null, idleft, idright); :}
    | palabraVal BOOL   identificador:id fin_sentencia
      {: parser.tabla.declararVariable(id, "bool", null, idleft, idright); :}
    | palabraVal CHAR   identificador:id fin_sentencia
      {: parser.tabla.declararVariable(id, "char", null, idleft, idright); :}
    | palabraVal STRING identificador:id fin_sentencia
      {: parser.tabla.declararVariable(id, "string", null, idleft, idright); :}
    | palabraVal INT    identificador:id asignacion:a expresion:e fin_sentencia:f
      {: parser.tabla.declararVariable(id, "int", parser.textoEntre(aleft, aright, fleft, fright), idleft, idright);
        parser.asignar(id, "int", e, idleft, idright); :}
    | palabraVal FLOAT  identificador:id asignacion:a expresion:e fin_sentencia:f
      {: parser.tabla.declararVariable(id, "float", parser.textoEntre(aleft, aright, fleft, fright), idleft, idright);
        parser.asignar(id, "float", e, idleft, idright); :}
    | palabraVal BOOL   identificador:id asignacion:a expresion:e fin_sentencia:f
      {: parser.tabla.declararVariable(id, "bool", parser.textoEntre(aleft, aright, fleft, fright), idleft, idright);
        parser.asignar(id, "bool", e, idleft, idright); :}
    | palabraVal CHAR   identificador:id asignacion:a expresion:e fin_sentencia:f
      {: parser.tabla.declararVariable(id, "char", parser.textoEntre(aleft, aright, fleft, fright), idleft, idright);
        parser.asignar(id, "char", e, idleft, idright); :}
    | palabraVal STRING identificador:id asignacion:a expresion:e fin_sentencia:f
      {: parser.tabla.declararVariable(id, "string", parser.textoEntre(aleft, aright, fleft, fright), idleft, idright);
        parser.asignar(id, "string", e, idleft, idright); :}
    ;

/* SEM: asignar a una variable que ya existe. El tipo de la variable se
   lee de la tabla de símbolos; si no está declarada, usar() devuelve null. */
asignacion_variable ::= identificador:id asignacion expresion:e fin_sentencia
                        {: Simbolo s = parser.tabla.usar(id, idleft, idright);
                          if (s != null) { parser.asignar(id, s.tipo, e, idleft, idright); } :} ;

lista_globales ::= /* vacío */
    | def_variable lista_globales
    | creacion_arreglo lista_globales
    | error fin_sentencia lista_globales
    ;


/* ============================================================
                    ENTRADA Y SALIDA
   ============================================================ */

lectura ::= leer identificador:id fin_sentencia                  {: parser.tabla.usar(id, idleft, idright); :}
          | leer acceso_arreglo fin_sentencia
          | leer PARENOP identificador:id PARENCL fin_sentencia  {: parser.tabla.usar(id, idleft, idright); :}
          | leer PARENOP acceso_arreglo PARENCL fin_sentencia
          ;

escritura ::= escribir valor_escritura fin_sentencia
            | escribir PARENOP expresion PARENCL fin_sentencia ;

impresion ::= palabraPrint PARENOP lista_valores PARENCL fin_sentencia ;

lista_valores ::= valor_escritura | valor_escritura coma lista_valores ;

valor_escritura ::= entero | flotante | bool | cadena_texto | caracter_literal
                  | identificador:id  {: parser.tabla.usar(id, idleft, idright); :}
                  | acceso_arreglo ;

/* ============================================================
                ARREGLOS
   ============================================================ */

indice ::= expresion_aritmetica:e  {: RESULT = e; :} ;

acceso_arreglo ::= identificador:id abrir_corcheteCuadrados indice:i cerrar_corcheteCuadrados
                  {: Simbolo s = parser.tabla.usarArreglo(id, idleft, idright);
                      RESULT = parser.elemento(s, id, i, idleft, idright); :} ;

creacion_arreglo ::= arreglo_con_tamano | arreglo_con_tamano_valores | arreglo_sin_tamano_valores ;

/* TS: las llaves de la lista de valores usan OPBLOCK/CLBLOCK directo,
   para que no abran un ámbito nuevo */
arreglo_con_tamano ::=
      palabraVal INT   identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c fin_sentencia
      {: parser.tabla.declararArreglo(id, "int", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), 0, null, idleft, idright);
        parser.arreglo(id, "int", i, null, idleft, idright); :}
    | palabraVal FLOAT identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c fin_sentencia
      {: parser.tabla.declararArreglo(id, "float", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), 0, null, idleft, idright);
        parser.arreglo(id, "float", i, null, idleft, idright); :}
    ;

arreglo_con_tamano_valores ::=
      palabraVal INT   identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_sentencia
      {: parser.tabla.declararArreglo(id, "int", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "int", i, n, idleft, idright); :}

    | palabraVal FLOAT identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_sentencia
      {: parser.tabla.declararArreglo(id, "float", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "float", i, n, idleft, idright); :}
    ;

arreglo_sin_tamano_valores ::=
      palabraVal INT   identificador:id abrir_corcheteCuadrados cerrar_corcheteCuadrados asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_sentencia
      {: parser.tabla.declararArreglo(id, "int", null, n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "int", null, n, idleft, idright); :}

    | palabraVal FLOAT identificador:id abrir_corcheteCuadrados cerrar_corcheteCuadrados asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_sentencia
      {: parser.tabla.declararArreglo(id, "float", null, n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "float", null, n, idleft, idright); :}
    ;


/* SEM: la lista guarda cada valor con su tipo (Atrib). El tamaño de la lista es n.size() */
lista_arreglo ::= inicio_lista_arreglo:l  {: RESULT = l; :} ;

inicio_lista_arreglo ::= expresion_aritmetica:e continuacion_lista_arreglo:l  {: l.add(0, e); RESULT = l; :} ;

continuacion_lista_arreglo ::= coma expresion_aritmetica:e continuacion_lista_arreglo:l  {: l.add(0, e); RESULT = l; :}
                             | /* vacío */  {: RESULT = new ArrayList(); :} ;

modificacion_arreglo ::= acceso_arreglo:a asignacion expresion:e fin_sentencia  {: parser.asignar(a.lugar, a.tipo, e, aleft, aright); :} ;


/* ============================================================
                OPERACIONES ARITMÉTICAS
   Precedencia (mayor a menor): pot, + -, * / //, mod
   ============================================================ */

operador_suma ::= PLUS   {: RESULT = "+"; :}
                | MINUS  {: RESULT = "-"; :} ;

operador_multiplicacion ::= MULTIPLY   {: RESULT = "*";  :}
                          | FLOATDIV   {: RESULT = "/";  :}
                          | ENTIREDIV  {: RESULT = "//"; :} ;

expresion_aritmetica ::= expresion_mod:e  {: RESULT = e; :} ;

expresion_mod ::= expresion_mod:a MOD:m expresion_multiplicacion:b  {: RESULT = parser.aritmetica(a, "mod", b, mleft, mright); :}
                | expresion_multiplicacion:e  {: RESULT = e; :} ;

expresion_multiplicacion ::= expresion_multiplicacion:a operador_multiplicacion:op expresion_suma:b {: RESULT = parser.aritmetica(a, op, b, opleft, opright); :}
                          | expresion_suma:e  {: RESULT = e; :} ;

expresion_suma ::= expresion_suma:a operador_suma:op expresion_unaria:b {: RESULT = parser.aritmetica(a, op, b, opleft, opright); :}
                | expresion_unaria:e  {: RESULT = e; :} ;

expresion_unaria ::= MINUS valor_numerico:v  {: RESULT = parser.negativo(v); :}
                  | expresion_potencia:e    {: RESULT = e; :} ;

expresion_potencia ::= valor_aritmetico:e  {: RESULT = e; :}
                    | valor_aritmetico:a operadorPotencia:p exponente:b {: RESULT = parser.aritmetica(a, "pot", b, pleft, pright); :} ;

exponente ::= valor_aritmetico:e        {: RESULT = e; :}
            | MINUS valor_numerico:v    {: RESULT = parser.negativo(v); :} ;

valor_aritmetico ::= valor_numerico:v   {: RESULT = v; :}
                  |  identificador:id
                    {: Simbolo s = parser.tabla.usar(id, idleft, idright);
                        if (s == null) { RESULT = new Atrib("error", id); }
                        else           { RESULT = new Atrib(s.tipo, id); } :}

                  | acceso_arreglo:a     {: RESULT = a; :}
                  | llamada_funcion      {: RESULT = new Atrib("error", "?"); :}
                  | cadena_texto:c       {: RESULT = c; :}
                  | caracter_literal:c   {: RESULT = c; :}
                  | PARENOP expresion_aritmetica:e PARENCL  {: RESULT = e; :} ;

operacion_incremento ::= identificador:id incremento  {: parser.tabla.usar(id, idleft, idright); :}
                      | identificador:id decremento  {: parser.tabla.usar(id, idleft, idright); :} ;


/* ============================================================
                OPERACIONES RELACIONALES
   ============================================================ */

operadorRelacional ::= LT     {: RESULT = "<";  :}
                    | GT     {: RESULT = ">";  :}
                    | LTE    {: RESULT = "<="; :}
                    | GTE    {: RESULT = ">="; :}
                    | EQUAL  {: RESULT = "=="; :}
                    | NEQ    {: RESULT = "!="; :} ;

operando_relacional ::= valor_aritmetico:v  {: RESULT = v; :}
                      | bool:b              {: RESULT = b; :}
                      | abrir_corcheteCuadrados expresion:e cerrar_corcheteCuadrados  {: RESULT = e; :} ;

operacion_relacional ::= operando_relacional:a operadorRelacional:op operando_relacional:b {: RESULT = parser.relacional(a, op, b, opleft, opright); :} ;


/* ============================================================
                EXPRESIONES LÓGICAS
   ============================================================ */

condicion_basica ::= PARENOP operacion_relacional:e PARENCL  {: RESULT = e; :}
                  | PARENOP bool:e PARENCL                  {: RESULT = e; :}
                  | PARENOP condicion_basica:e PARENCL      {: RESULT = e; :}
                  | condiciones_logicas:e                   {: RESULT = e; :}
                  | negacion:e               {: RESULT = e; :} ;

operando_logico ::= condicion_basica:e                       {: RESULT = e; :}
                  | PARENOP expresion_aritmetica:e PARENCL   {: RESULT = e; :} ;

condiciones_and ::= operando_logico:a AND:o operando_logico:b
                    {: RESULT = parser.logica(a, "and", b, oleft, oright); :}
                  | condiciones_and:a AND:o operando_logico:b
                    {: RESULT = parser.logica(a, "and", b, oleft, oright); :} ;

condiciones_or ::= operando_logico:a OR:o operando_logico:b
                  {: RESULT = parser.logica(a, "or", b, oleft, oright); :}

                | condiciones_and:a OR:o operando_logico:b
                  {: RESULT = parser.logica(a, "or", b, oleft, oright); :}

                | operando_logico:a OR:o condiciones_and:b
                  {: RESULT = parser.logica(a, "or", b, oleft, oright); :}

                | condiciones_and:a OR:o condiciones_and:b
                  {: RESULT = parser.logica(a, "or", b, oleft, oright); :}

                | condiciones_or:a OR:o operando_logico:b
                  {: RESULT = parser.logica(a, "or", b, oleft, oright); :}
                  
                | condiciones_or:a OR:o condiciones_and:b
                  {: RESULT = parser.logica(a, "or", b, oleft, oright); :} ;

condiciones_logicas ::= PARENOP condiciones_and:e PARENCL  {: RESULT = e; :}
                      | PARENOP condiciones_or:e PARENCL   {: RESULT = e; :} ;

negacion ::= NOT:n condicion_basica:e  {: RESULT = parser.negacion(e, nleft, nright); :} ;

expresion_logica ::= condiciones_and:e  {: RESULT = e; :}
                  | condiciones_or:e   {: RESULT = e; :}
                  | negacion:e         {: RESULT = e; :} ;

condicion_control ::= operacion_relacional:e                   {: RESULT = e; :}
                    | condiciones_and:e                        {: RESULT = e; :}
                    | condiciones_or:e                         {: RESULT = e; :}
                    | negacion:e                               {: RESULT = e; :}
                    | bool:e                                   {: RESULT = e; :}
                    | PARENOP operacion_relacional:e PARENCL   {: RESULT = e; :}
                    | PARENOP bool:e PARENCL                   {: RESULT = e; :} ;


/* ============================================================
                EXPRESIONES Y FUNCIONES
   ============================================================ */

expresion ::= expresion_aritmetica:e  {: RESULT = e; :}
            | operacion_relacional:r  {: RESULT = r; :}
            | expresion_logica:l      {: RESULT = l; :}
            | bool:b                  {: RESULT = b; :} ;

lista_expresiones ::= /* vacío */ {: RESULT = new ArrayList<Atrib>(); :}
                    | expresiones:e {: RESULT = e; :} ;

expresiones ::= 
                    expresion:e
                    {:
                      ArrayList<Atrib> lista = new ArrayList<Atrib>();
                      lista.add(e);
                      RESULT = lista;
                    :}
                    | expresion:e coma expresiones:l 
                    {:
                      l.add(0, e);
                      RESULT = l;
                    :}
                    ;

llamada_funcion ::= identificador:id PARENOP lista_expresiones:args PARENCL
                    {: RESULT = parser.validarLlamada(id, args, idleft, idright); :} ;


/* ============================================================
                ESTRUCTURAS DE CONTROL
   ============================================================ */

if ::= palabraIf PARENOP condicion_control PARENCL abrir_bloque bloque cerrar_bloque demas_if
    | palabraIf negacion abrir_bloque bloque cerrar_bloque demas_if
    | palabraIf error abrir_bloque bloque cerrar_bloque demas_if ;

demas_if ::= cadena_elif fin_if | fin_if ;

fin_if ::= else | /* vacío */ ;

elif ::= palabraElif PARENOP condicion_control PARENCL abrir_bloque bloque cerrar_bloque
      | palabraElif error abrir_bloque bloque cerrar_bloque ;

cadena_elif ::= elif | elif cadena_elif ;

else ::= palabraElse abrir_bloque bloque cerrar_bloque
      | palabraElse error abrir_bloque bloque cerrar_bloque ;

while ::= palabraWhile PARENOP condicion_control PARENCL abrir_bloque bloque cerrar_bloque
        | palabraWhile error abrir_bloque bloque cerrar_bloque ;

/* TS: al terminar el for se cierra el ámbito que abrió palabraFor */
for ::= palabraFor PARENOP inicio_for fin_sentencia condicion_for fin_sentencia incremento_for PARENCL abrir_bloque bloque cerrar_bloque
        {: parser.tabla.cerrarAmbito(); :}
      | palabraFor error abrir_bloque bloque cerrar_bloque
        {: parser.tabla.cerrarAmbito(); :}
      ;

inicio_for ::= /* vacío */
            | identificador:id asignacion expresion{: parser.tabla.usar(id, idleft, idright); :}

            | palabraVal tipo:t identificador:id asignacion:a expresion{: parser.tabla.declararVariable(id, t, parser.textoDesde(aleft, aright), idleft, idright); :};

condicion_for ::= /* vacío */   operacion_relacional
                | expresion_logica
                | bool
                | PARENOP operacion_relacional PARENCL
                | PARENOP bool PARENCL ;

incremento_for ::= /* vacío */
                | operacion_incremento
                | expresion_aritmetica
                | identificador:id asignacion expresion  {: parser.tabla.usar(id, idleft, idright); :};

estructura_control ::= if | while | for ;


/* ============================================================
                SENTENCIAS Y BLOQUES
   ============================================================ */

break ::= palabraBreak ;

return ::= palabraReturn fin_sentencia | palabraReturn expresion fin_sentencia ;

instruccion ::= sentencia_simple | estructura_control ;

sentencia_simple ::=
      asignacion_variable
    | def_variable
    | creacion_arreglo
    | modificacion_arreglo
    | lectura
    | escritura
    | impresion
    | operacion_incremento
    | llamada_funcion fin_sentencia
    | break fin_sentencia
    | return
    | error fin_sentencia
    ;

lista_instrucciones ::= instruccion | instruccion lista_instrucciones ;

bloque ::= /* vacío */ | lista_instrucciones ;


/* ============================================================
                    PARÁMETROS
   ============================================================ */

parametro ::= tipo:t identificador:id
              {: RESULT = new Simbolo(id, t, Simbolo.PARAMETRO, idleft, idright); :} ;

lista_parametros ::= /* vacío */ {: RESULT = new ArrayList(); :}
                  | parametros:l     {: RESULT = l; :} ;

parametros ::= parametro:p {: ArrayList l = new ArrayList(); l.add(p); RESULT = l; :}

            | parametro:p coma parametros:l {: l.add(0, p); RESULT = l; :} ;


/* ============================================================
                        FUNCIONES
   ============================================================ */

/* TS: el encabezado se reduce ANTES del cuerpo, así la función ya existe
   (permite recursión) y sus parámetros entran al ámbito del cuerpo */
encabezado_funcion ::= tipo:t identificador:id PARENOP lista_parametros:p PARENCL {: parser.tabla.declararFuncion(id, t, p, idleft, idright); :} ;

encabezado_void ::= VOID identificador:id PARENOP lista_parametros:p PARENCL {: parser.tabla.declararFuncion(id, "void", p, idleft, idright); :} ;

funcion_no_void ::= encabezado_funcion abrir_bloque bloque cerrar_bloque

                  | tipo error abrir_bloque bloque cerrar_bloque ;

funcion_void ::= encabezado_void abrir_bloque bloque cerrar_bloque ;


/* ============================================================
                        PRINCIPAL
   ============================================================ */

principal ::= VOID Principal PARENOP PARENCL abrir_bloque bloque cerrar_bloque ;


/* ============================================================
                  UNIDADES DEL PROGRAMA
   ============================================================ */

unidades_programa ::= principal | funcion_no_void unidades_programa | funcion_void unidades_programa ;


/* ============================================================
                        PROGRAMA
   ============================================================ */

programa ::= lista_globales unidades_programa ;
