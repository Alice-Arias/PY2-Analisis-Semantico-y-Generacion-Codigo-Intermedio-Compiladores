import java_cup.runtime.*;
import java.util.ArrayList;

/* ============================================================
                CÓDIGO DEL PARSER: TABLA DE SÍMBOLOS
(si ya tienes un bloque "parser code", agrega la línea dentro)
   ============================================================ */

parser code {:
    public TablaSimbolos tabla = new TablaSimbolos();

    /* TS: guardo los tokens leídos para recuperar el texto del valor inicial y del tamaño de los arreglos */
    private final ArrayList<Symbol> leidos = new ArrayList<Symbol>();

    @Override
    public Symbol scan() throws Exception {
        Symbol s = super.scan();
        leidos.add(s);
        return s;
    }

    /* Texto de los tokens que están entre dos tokens (por posición). */
    public String textoEntre(int l1, int c1, int l2, int c2) {
        int fin = -1;
        for (int i = leidos.size() - 1; i >= 0; i--) {
            Symbol t = leidos.get(i);
            if (t.left == l2 && t.right == c2) { fin = i; break; }
        }
        int ini = -1;
        for (int i = fin - 1; i >= 0; i--) {
            Symbol t = leidos.get(i);
            if (t.left == l1 && t.right == c1) { ini = i; break; }
        }
        if (ini < 0 || fin < 0) return null;
        StringBuilder sb = new StringBuilder();
        for (int i = ini + 1; i < fin; i++) {
            String v = String.valueOf(leidos.get(i).value);
            if (sb.length() > 0 && !v.equals(",")) sb.append(" ");
            sb.append(v);
        }
        return sb.toString();
    }

    /* Texto desde un token hasta antes del token de anticipación. */
    public String textoDesde(int l1, int c1) {
        if (leidos.isEmpty()) return null;
        Symbol ultimo = leidos.get(leidos.size() - 1);
        return textoEntre(l1, c1, ultimo.left, ultimo.right);
    }

    /* Texto del valor inicial de una variable (lo que va entre Ͱ y »).
       Si el parser ya leyó el token que sigue al », el texto trae el » al final: se quita. */
    public String textoValor(int linea, int columna) {
        String t = textoDesde(linea, columna);
        if (t != null && t.endsWith("»")) {
            t = t.substring(0, t.length() - 1).trim();
        }
        return t;
    }

    /* SEM: comprueba los tipos de una operación aritmética.
    Entrada: los dos operandos (con su tipo), el operador y su posición.
    Salida:  un Atrib con el tipo del resultado, o de tipo "error".
       Restricción: int y float no se mezclan (tipado fuerte). */
    public Atrib aritmetica(Atrib a, String op, Atrib b, int linea, int columna) {

        /* Regla 1: si alguno ya falló, no repetir el mensaje */
        if (a.tipo.equals("error") || b.tipo.equals("error")) {
            return new Atrib("error", "?");
        }

        /* Regla 2: los dos deben ser int o float */
        boolean aNumerico = a.tipo.equals("int") || a.tipo.equals("float");
        boolean bNumerico = b.tipo.equals("int") || b.tipo.equals("float");
        if (!aNumerico || !bNumerico) {
            reportar("ARI-2", linea, columna, "el operador '" + op + "' no se puede aplicar a '"
                    + a.tipo + "' y '" + b.tipo + "' (se requieren int o float)");
            return new Atrib("error", "?");
        }

        /* Regla 3: no se mezclan int y float */
        if (!a.tipo.equals(b.tipo)) {
            reportar("ARI-3", linea, columna, "no se pueden mezclar '" + a.tipo + "' y '"
                    + b.tipo + "' con el operador '" + op + "' (tipado fuerte)");
            return new Atrib("error", "?");
        }

        /* Regla 3b: "//" solo trabaja con enteros */
        if (op.equals("//") && !a.tipo.equals("int")) {
            reportar("ARI-4", linea, columna, "el operador '//' requiere operandos int y recibió '"
                    + a.tipo + "'");
            return new Atrib("error", "?");
        }

        /* Regla 3c: "/" solo trabaja con float */
        if (op.equals("/") && !a.tipo.equals("float")) {
            reportar("ARI-5", linea, columna, "el operador '/' requiere operandos float y recibió '"
                    + a.tipo + "'");
            return new Atrib("error", "?");
        }

        /* Regla 3d: la potencia solo admite exponente positivo */
        if (op.equals("pot") && (b.lugar.startsWith("-") || (b.valor != null && b.valor < 0))) {
            reportar("ARI-7", linea, columna, "el operador 'pot' requiere un exponente positivo");
            return new Atrib("error", "?");
        }

        /* Regla 4: todo bien, el resultado tiene el tipo de los operandos.
           Si los dos son constantes enteras, también se calcula su valor. */
        Atrib r = new Atrib(a.tipo, "?");
        r.valor = plegar(a, op, b);
        return r;
    }

    /* SEM: convierte un texto en entero (null si no cabe en un int). */
    public Integer aEntero(String texto) {
        try {
            return Integer.valueOf(texto.trim());
        } catch (NumberFormatException e) {
            return null;
        }
    }

    /* SEM: el signo menos delante de un número; conserva el valor constante. */
    public Atrib negativo(Atrib v) {
        Atrib r = new Atrib(v.tipo, "-" + v.lugar);
        if (v.valor != null) {
            r.valor = -v.valor;
        }
        return r;
    }

    /* SEM: calcula "a op b" cuando los dos son constantes enteras (null si no se puede).
       La división entera // trunca hacia cero. */
    private Integer plegar(Atrib a, String op, Atrib b) {
        if (!a.tipo.equals("int") || a.valor == null || b.valor == null) {
            return null;
        }
        long x = a.valor;
        long y = b.valor;
        long r;
        switch (op) {
            case "+":   r = x + y; break;
            case "-":   r = x - y; break;
            case "*":   r = x * y; break;
            case "//":  if (y == 0) return null; r = x / y; break;
            case "mod": if (y == 0) return null; r = x % y; break;
            case "pot":
                if (y < 0 || y > 30) return null;
                r = 1;
                for (long k = 0; k < y; k++) {
                    r *= x;
                    if (Math.abs(r) > Integer.MAX_VALUE) return null;
                }
                break;
            default:    return null;
        }
        if (r > Integer.MAX_VALUE || r < Integer.MIN_VALUE) {
            return null;
        }
        return (int) r;
    }

    /* SEM: texto del tamaño de un arreglo para la tabla de símbolos:
       el valor calculado si es constante (1 + 1 -> "2") o el texto original. */
    public String tamanoTexto(Atrib tam, String crudo) {
        return (tam != null && tam.valor != null) ? String.valueOf(tam.valor) : crudo;
    }

    /* SEM: comprueba que el valor tenga el mismo tipo que la variable.
    Entrada: nombre y tipo de la variable, el valor (con su tipo) y la posición.
       Salida:  ninguna; si no coinciden, reporta un error semántico. */
    public void asignar(String regla, String nombre, String tipoVar, Atrib valor, int linea, int columna) {

        /* Regla 1: si el valor o la variable ya fallaron, no repetir el mensaje */
        if (valor.tipo.equals("error") || tipoVar.equals("error")) {
            return;
        }

        /* Regla 2: el tipo del valor debe ser igual al de la variable */
        if (!tipoVar.equals(valor.tipo)) {
            reportar(regla, linea, columna, "la variable '" + nombre + "' es de tipo '"
                    + tipoVar + "' y se le da un valor de tipo '" + valor.tipo + "'");
        }
    }

    /* SEM: comprueba la declaración de un arreglo.
    Entrada: nombre, tipo de los elementos, el tamaño (puede ser null), la lista de
                valores iniciales (puede ser null) y la posición.
    Reglas:  el tamaño debe ser una expresión int y mayor que cero;
                cada valor debe tener el tipo del arreglo;
                no pueden darse más valores que el tamaño (si el tamaño se conoce). */
    public void arreglo(String id, String tipo, Atrib tam, ArrayList valores, int linea, int columna) {

        /* Regla 1: el tamaño debe ser int (si ya falló, no repetir el mensaje) */
        Integer tamano = null;
        if (tam != null && !tam.tipo.equals("error")) {
            if (!tam.tipo.equals("int")) {
                reportar("ARR-1", linea, columna, "el tamaño del arreglo '" + id
                        + "' debe ser int y se encontró '" + tam.tipo + "'");
            } else if (tam.valor != null) {
                tamano = tam.valor;
                if (tamano <= 0) {
                    reportar("ARR-2", linea, columna, "el tamaño del arreglo '" + id
                            + "' debe ser mayor que 0 y es " + tamano);
                    tamano = null;
                }
            }
        }

        if (valores == null) {
            return;
        }

        /* Regla 2: todos los valores deben tener el tipo del arreglo (un solo mensaje) */
        int malos = 0;
        int primero = -1;
        String tipoPrimero = null;
        for (int k = 0; k < valores.size(); k++) {
            Atrib v = (Atrib) valores.get(k);
            if (!v.tipo.equals("error") && !v.tipo.equals(tipo)) {
                malos++;
                if (primero < 0) { primero = k; tipoPrimero = v.tipo; }
            }
        }
        if (malos > 0) {
            reportar("ARR-3", linea, columna, "el arreglo '" + id + "' es de tipo '" + tipo + "' pero "
                    + malos + " de sus " + valores.size() + " valores no lo son (el primero es el elemento "
                    + primero + ", de tipo '" + tipoPrimero + "')");
        }

        /* Regla 3: no pueden sobrar valores si el tamaño se conoce */
        if (tamano != null && valores.size() > tamano) {
            reportar("ARR-4", linea, columna, "el arreglo '" + id + "' tiene tamaño " + tamano
                    + " pero se dieron " + valores.size() + " valores");
        }
    }

    /* SEM: función en la que estamos (para comprobar el return) */
    public String funTipo = null;
    public String funNombre = null;

    /* SEM: comprueba una llamada a función: cantidad y tipo de los argumentos.
    Entrada: la función (puede ser null si no existe), su nombre, la lista de
                argumentos (cada uno con su tipo) y la posición de la llamada.
       Salida:  un Atrib con el tipo de retorno de la función (el lugar guarda su nombre). */
    public Atrib llamada(Simbolo f, String id, ArrayList args, int linea, int columna) {

        /* Regla 1: si no existe o no es una función, usarFuncion ya reportó el error */
        if (f == null || !f.esFuncion()) {
            return new Atrib("error", id);
        }

        /* Regla 2: la cantidad de argumentos debe coincidir con la de parámetros */
        int esperados = f.parametros.size();
        if (args.size() != esperados) {
            reportar("FUN-1", linea, columna, "la función '" + id + "' espera " + esperados
                    + " argumento(s) y recibió " + args.size());
        } else {
            /* Regla 3: cada argumento debe tener el tipo de su parámetro */
            for (int k = 0; k < esperados; k++) {
                Atrib a = (Atrib) args.get(k);
                Simbolo p = (Simbolo) f.parametros.get(k);
                if (!a.tipo.equals("error") && !a.tipo.equals(p.tipo)) {
                    reportar("FUN-2", linea, columna, "el argumento " + (k + 1) + " de '" + id
                            + "' debe ser '" + p.tipo + "' y se encontró '" + a.tipo + "'");
                }
            }
        }

        /* Regla 4: el resultado tiene el tipo de retorno de la función */
        return new Atrib(f.tipo, id);
    }

    /* SEM: comprueba el acceso a un elemento de arreglo: nombre[indice].
    Entrada: el símbolo del arreglo (puede ser null), su nombre, el índice y la posición.
    Salida:  un Atrib con el tipo de los elementos del arreglo, o de tipo "error".
       Los índices empiezan en 0: un arreglo de tamaño n tiene los índices 0 a n-1. */
    public Atrib elemento(Simbolo s, String id, Atrib indice, int linea, int columna) {

        /* Regla 1: si no existe o no es un arreglo, usarArreglo ya reportó el error */
        if (s == null || !s.categoria.equals("arreglo")) {
            return new Atrib("error", id);
        }

        /* Regla 2: el índice debe ser int (si ya falló, no repetir el mensaje) */
        if (!indice.tipo.equals("error") && !indice.tipo.equals("int")) {
            reportar("ARR-5", linea, columna, "el índice del arreglo '" + id
                    + "' debe ser int y se encontró '" + indice.tipo + "'");
        }

        /* Regla 3: si el índice es una constante, debe caer dentro del arreglo */
        if (indice.valor != null) {
            int v = indice.valor;
            if (v < 0) {
                reportar("ARR-7", linea, columna, "el índice " + v + " del arreglo '" + id
                        + "' no puede ser negativo");
            } else if (s.elementos > 0 && v >= s.elementos) {
                reportar("ARR-6", linea, columna, "el índice " + v + " está fuera del arreglo '" + id
                        + "' (índices válidos: 0 a " + (s.elementos - 1) + ")");
            }
        }

        /* Regla 4: el elemento tiene el tipo del arreglo (el lugar guarda el nombre) */
        return new Atrib(s.tipo, id);
    }

    /* SEM: comprueba los tipos de una operación lógica (and, or).
       Salida: siempre un Atrib de tipo "bool". */
    public Atrib logica(Atrib a, String op, Atrib b, int linea, int columna) {

        /* Regla 1: si alguno ya falló, no repetir el mensaje */
        if (a.tipo.equals("error") || b.tipo.equals("error")) {
            return new Atrib("bool", "?");
        }

        /* Regla 2: los dos operandos deben ser bool */
        if (!a.tipo.equals("bool") || !b.tipo.equals("bool")) {
            reportar("LOG-1", linea, columna, "el operador lógico '" + op
                    + "' requiere operandos bool y recibió '" + a.tipo + "' y '" + b.tipo + "'");
        }

        /* Regla 3: el resultado siempre es bool, aunque haya fallado */
        return new Atrib("bool", "?");
    }

    /* SEM: comprueba el tipo de una negación (not). */
    public Atrib negacion(Atrib e, int linea, int columna) {

        if (e.tipo.equals("error")) {
            return new Atrib("bool", "?");
        }

        if (!e.tipo.equals("bool")) {
            reportar("LOG-2", linea, columna, "el operador 'not' requiere un operando bool y recibió '"
                    + e.tipo + "'");
        }

        return new Atrib("bool", "?");
    }

    /* ====================================================================
    REGLAS SOBRE LOS NOMBRES: declarar y usar
    La tabla de símbolos solo guarda y busca; aquí se decide qué es un error.
       ==================================================================== */

    /* Regla PRG-1: el programa debe tener una función principal.
       Si se repite, declararFuncion ya reporta el nombre repetido (TS-1). */
    public void finPrograma() {
        if (tabla.buscar("principal") == null) {
            int linea = 1;
            int columna = 1;
            for (int i = leidos.size() - 1; i >= 0; i--) {
                Symbol t = leidos.get(i);
                if (t.left > 0) {
                    linea = t.left;
                    columna = t.right;
                    break;
                }
            }
            reportar("PRG-1", linea, columna, "el programa debe tener una función principal");
        }
    }

    /* Recuperación a nivel de frase: avisa que falta el terminador. Main lo
       sobrescribe para registrarlo como error sintáctico; aquí no hace nada. */
    public void tokenFaltante(String token, int linea, int columna) {
    }

    /* El » que falta va justo después del último token de la sentencia, es decir,
       antes del token que el parser acaba de leer (el que sigue). */
    public void faltaTerminador() {
        faltaToken("»");
    }

    /* Avisa que falta un token (», :э o :?). Va justo después del último token de la frase,
       o sea, antes del token que el parser acaba de leer. */
    public void faltaToken(String token) {
        int n = leidos.size();
        if (n >= 2) {
            Symbol previo = leidos.get(n - 2);
            int largo = previo.value == null ? 1 : Math.max(1, String.valueOf(previo.value).length());
            tokenFaltante(token, previo.left, previo.right + largo);
        }
    }

    /* Guarda un error semántico con el código de su regla, por ejemplo
    "[ARI-3] no se pueden mezclar ...". Main usa el código para clasificar
       el error por tipo de validación y mostrarlo con su color. */
    private void reportar(String regla, int linea, int columna, String mensaje) {
        tabla.errorSemantico(linea, columna, "[" + regla + "] " + mensaje);
    }

    /* Código de una comparación fallida: REL-1 (== y !=), REL-2 (< > <= >=)
       o REL-3 (alguno de los operandos es string). */
    private String codigoRel(String op, Atrib a, Atrib b) {
        if (a.tipo.equals("string") || b.tipo.equals("string")) {
            return "REL-3";
        }
        return (op.equals("==") || op.equals("!=")) ? "REL-1" : "REL-2";
    }

    /* Regla: un nombre no puede declararse dos veces en el mismo ámbito. */
    private void repetido(String regla, Simbolo previo, String id, int linea, int columna) {
        if (previo != null) {
            reportar(regla, linea, columna, "'" + id
                    + "' ya fue declarado en este ámbito (línea " + previo.linea + ")");
        }
    }

    public void declararVariable(String id, String tipo, String valorInicial, int linea, int columna) {
        repetido("TS-1", tabla.declararVariable(id, tipo, valorInicial, linea, columna), id, linea, columna);
    }

    public void declararArreglo(String id, String tipo, String tamano, int elementos,
                                String valores, int linea, int columna) {
        repetido("TS-1", tabla.declararArreglo(id, tipo, tamano, elementos, valores, linea, columna),id, linea, columna);
    }

    /* Reglas de una función:
    1. Una función no puede retornar string (solo int, float, char o bool).
    2. Los parámetros no pueden repetirse.
    3. Su nombre no puede estar repetido en el ámbito global.
       Además deja anotada la función actual, para comprobar sus return. */
    public void declararFuncion(String id, String tipo, ArrayList params, int linea, int columna) {

        if (tipo.equals("string")) {
            reportar("FUN-3", linea, columna, "la función '" + id
                    + "' no puede retornar string (solo int, float, char o bool)");
        }

        if (params != null) {
            for (int i = 1; i < params.size(); i++) {
                Simbolo p = (Simbolo) params.get(i);
                for (int j = 0; j < i; j++) {
                    Simbolo q = (Simbolo) params.get(j);
                    if (q.nombre.equals(p.nombre)) {
                        repetido("FUN-4", q, p.nombre, p.linea, p.columna);
                        break;
                    }
                }
            }
        }

        repetido("TS-1", tabla.declararFuncion(id, tipo, params, linea, columna), id, linea, columna);

        funTipo = tipo;
        funNombre = id;
        hayReturn = false;
        lineaFuncion = linea;
        columnaFuncion = columna;
    }

    /* Regla: una función con tipo debe tener al menos un return (con o sin valor).
       Se comprueba al cerrar el cuerpo de la función. */
    private boolean hayReturn = false;
    private int lineaFuncion = 0;
    private int columnaFuncion = 0;

    public void finFuncion() {
        if (funTipo != null && !funTipo.equals("void") && !hayReturn) {
            reportar("FUN-7", lineaFuncion, columnaFuncion, "la función '" + funNombre
                    + "' debe tener al menos un return");
        }
    }

    /* Reglas de uso de una variable:
    1. Debe estar declarada.
    2. No puede ser una función.
    3. No puede ser un arreglo sin índice.
       Si alguna falla se reporta y se devuelve null (no se repite el mensaje). */
    public Simbolo usar(String nombre, int linea, int columna) {
        Simbolo s = tabla.buscar(nombre);
        if (s == null) {
            reportar("TS-2", linea, columna, "'" + nombre + "' no ha sido declarado");
            return null;
        }
        if (s.esFuncion()) {
            reportar("TS-6", linea, columna, "'" + nombre + "' es una función y se usa como variable");
            return null;
        }
        if (s.categoria.equals(Simbolo.ARREGLO)) {
            reportar("TS-7", linea, columna, "'" + nombre + "' es un arreglo y debe usarse con un índice");
            return null;
        }
        return s;
    }

    /* Reglas de uso de un arreglo: debe estar declarado y ser un arreglo. */
    public Simbolo usarArreglo(String nombre, int linea, int columna) {
        Simbolo s = tabla.buscar(nombre);
        if (s == null) {
            reportar("TS-4", linea, columna, "el arreglo '" + nombre + "' no ha sido declarado");
        } else if (!s.categoria.equals(Simbolo.ARREGLO)) {
            reportar("TS-5", linea, columna, "'" + nombre + "' no es un arreglo");
        }
        return s;
    }

    /* Reglas de uso de una función: debe estar declarada y ser una función. */
    public Simbolo usarFuncion(String nombre, int linea, int columna) {
        Simbolo s = tabla.buscar(nombre);
        if (s == null) {
            reportar("TS-3", linea, columna, "la función '" + nombre + "' no ha sido declarada");
        } else if (!s.esFuncion()) {
            reportar("TS-3", linea, columna, "'" + nombre + "' no es una función");
        }
        return s;
    }

    /* ====================================================================
        COMPARACIONES
       ==================================================================== */

    /* SEM: comprueba los tipos de una comparación (<, >, <=, >=, ==, !=).
        Reglas:  < > <= >= : los dos int o los dos float.
                == y !=   : int, float, bool o char; mismo tipo, o los dos numéricos.
                Los string no se comparan.
       Salida:  siempre un Atrib de tipo "bool". */
    public Atrib relacional(Atrib a, String op, Atrib b, int linea, int columna) {

        /* Regla 1: si alguno ya falló, no repetir el mensaje */
        if (a.tipo.equals("error") || b.tipo.equals("error")) {
            return new Atrib("bool", "?");
        }

        boolean aNumerico = a.tipo.equals("int") || a.tipo.equals("float");
        boolean bNumerico = b.tipo.equals("int") || b.tipo.equals("float");
        boolean valida;

        if (op.equals("==") || op.equals("!=")) {
            /* Regla 2: igualdad: int, float, bool o char; mismo tipo, o los dos numéricos */
            boolean permitido = aNumerico || a.tipo.equals("bool") || a.tipo.equals("char");
            valida = permitido && (a.tipo.equals(b.tipo) || (aNumerico && bNumerico));
        } else {
            /* Regla 3: orden: solo numéricos y del mismo tipo */
            valida = aNumerico && a.tipo.equals(b.tipo);
        }

        if (!valida) {
            reportar(codigoRel(op, a, b), linea, columna, "no se puede comparar '" + a.tipo
                    + "' con '" + b.tipo + "' usando '" + op + "'");
        }

        /* Regla 4: una comparación siempre da bool, aunque haya fallado */
        return new Atrib("bool", "?");
    }

    /* ====================================================================
        RETURN, BREAK, CONDICIONES, ++ y --, READ y WRITE
       ==================================================================== */

    /* SEM: comprueba un return contra la función en la que está.
       valor es null cuando el return no lleva expresión (se permite). */
    public void retorno(Atrib valor, int linea, int columna) {

        hayReturn = true;

        if (funTipo == null || valor == null) {
            return;
        }

        /* Regla 1: un procedimiento void no devuelve nada, sea cual sea el valor */
        if (funTipo.equals("void")) {
            reportar("RET-1", linea, columna, "el procedimiento '" + funNombre
                    + "' no puede retornar un valor");
            return;
        }

        /* Regla 2: si el valor ya falló, no repetir el mensaje */
        if (valor.tipo.equals("error")) {
            return;
        }

        /* Regla 3: el valor debe tener el tipo de la función */
        if (!valor.tipo.equals(funTipo)) {
            reportar("RET-2", linea, columna, "la función '" + funNombre
                    + "' debe retornar un valor de tipo " + funTipo
                    + ", pero se recibió " + valor.tipo);
        }
    }

    /* SEM: break solo puede estar dentro de un while o de un for. */
    private int ciclosActivos = 0;

    public void entrarCiclo() {
        ciclosActivos++;
    }

    public void salirCiclo() {
        if (ciclosActivos > 0) {
            ciclosActivos--;
        }
    }

    public void validarBreak(int linea, int columna) {
        if (ciclosActivos == 0) {
            reportar("CON-5", linea, columna, "break solo puede utilizarse dentro de un ciclo");
        }
    }

    /* SEM: la condición de un if, elif, while o for debe ser bool. */
    public void condicion(String regla, Atrib c, int linea, int columna) {

        if (c == null || c.tipo.equals("error")) {
            return;
        }

        if (!c.tipo.equals("bool")) {
            reportar(regla, linea, columna, "la condición debe ser de tipo bool, pero se recibió "
                    + c.tipo);
        }
    }

    /* SEM: ++ y -- solo se aplican a variables int o float. */
    public void incrementar(Simbolo s, String id, String op, int linea, int columna) {

        if (s == null) {
            return;
        }

        if (!s.tipo.equals("int") && !s.tipo.equals("float")) {
            reportar("INC-1", linea, columna, "el operador '" + op
                    + "' solo se aplica a variables int o float y '" + id + "' es de tipo " + s.tipo);
        }
    }

    /* SEM: read recibe una variable o un elemento de arreglo de tipo int, float o char. */
    public void leer(Atrib destino, int linea, int columna) {

        if (destino == null || destino.tipo.equals("error")) {
            return;
        }

        if (!destino.tipo.equals("int") && !destino.tipo.equals("float") && !destino.tipo.equals("char")) {
            reportar("ES-1", linea, columna,
                    "read solo permite valores de tipo int, float o char; se recibió " + destino.tipo);
        }
    }

    /* SEM: write solo escribe valores de tipo int, float o string
       (el ejemplo2 del profe marca como semántico escribir un bool o un char). */
    public void escribir(Atrib valor, int linea, int columna) {

        if (valor == null || valor.tipo.equals("error")) {
            return;
        }

        if (!valor.tipo.equals("int") && !valor.tipo.equals("float") && !valor.tipo.equals("string")) {
            reportar("ES-2", linea, columna, "write no permite valores de tipo " + valor.tipo);
        }
    }

:};

/* ============================================================
                        TERMINALES
   ============================================================ */

/* Operadores aritméticos */
terminal INCREMENT, PLUS, DECREMENT, MINUS, MULTIPLY;
terminal ENTIREDIV, FLOATDIV, MOD, POT;

/* Operadores relacionales */
terminal LTE, GTE, EQUAL, NEQ, LT, GT;

/* Operadores lógicos */
terminal AND, OR, NOT;

/* Delimitadores */
terminal OPBLOCK, CLBLOCK;
terminal PARENOP, PARENCL;
terminal OPBRACKET, CLBRACKET;
terminal TERMINATOR, ASIGN, COMA;

/* Tipos y palabras reservadas */
terminal VAL;
terminal PRINCIPAL;
terminal INT, FLOAT, BOOL, CHAR, STRING, VOID;
terminal TRUE, FALSE;

/* Estructuras de control */
terminal IF, ELIF, ELSE;
terminal WHILE, FOR;
terminal RETURN, BREAK;

/* Entrada y salida */
terminal PRINT, READ, WRITE;

/* Literales e identificadores */
terminal LITERAL_INT;
terminal LITERAL_FLOAT;
terminal LITERAL_STRING;
terminal LITERAL_CHAR;
terminal String ID;                         /* TS: el ID lleva su lexema */


/* ============================================================
                        NO TERMINALES
   ============================================================ */

non terminal programa;
non terminal lista_globales;
non terminal unidades_programa;
non terminal unidad;
non terminal String tipo;                   /* TS */

/* Valores */
non terminal Atrib valor_numerico;
non terminal Atrib entero;
non terminal Atrib flotante;
non terminal Atrib bool;
non terminal Atrib cadena_texto;
non terminal Atrib caracter_literal;
non terminal Atrib condicion_control;

/* Identificadores */
non terminal String identificador;          /* TS */

/* Delimitadores */
non terminal abrir_bloque;
non terminal cerrar_bloque;
non terminal abrir_corcheteCuadrados;
non terminal cerrar_corcheteCuadrados;
non terminal coma;
non terminal fin_sentencia;
non terminal fin_o_falta;
non terminal cierra_paren;
non terminal cierra_bloque_fn;
non terminal asignacion;
non terminal incremento;
non terminal decremento;

/* Palabras reservadas y operadores */
non terminal palabraVal;
non terminal palabraBreak;
non terminal palabraReturn;
non terminal Principal;
non terminal palabraIf;
non terminal palabraElif;
non terminal palabraElse;
non terminal palabraWhile;
non terminal palabraFor;
non terminal operadorPotencia;
non terminal leer;
non terminal escribir;

/* Variables */
non terminal def_variable;
non terminal asignacion_variable;

/* Entrada y salida */
non terminal lectura;
non terminal escritura;
non terminal Atrib valor_escritura;

/* Arreglos */
non terminal Atrib indice;
non terminal Atrib acceso_arreglo;
non terminal creacion_arreglo;
non terminal arreglo_con_tamano;
non terminal arreglo_con_tamano_valores;
non terminal arreglo_sin_tamano_valores;
non terminal ArrayList lista_arreglo;
non terminal ArrayList inicio_lista_arreglo;
non terminal ArrayList continuacion_lista_arreglo;
non terminal modificacion_arreglo;

/* Operaciones aritméticas */
non terminal String operador_suma;
non terminal String operador_multiplicacion;
non terminal Atrib expresion_aritmetica;
non terminal Atrib expresion_mod;
non terminal Atrib expresion_suma;
non terminal Atrib expresion_multiplicacion;
non terminal Atrib expresion_unaria;
non terminal Atrib expresion_potencia;
non terminal Atrib exponente;
non terminal Atrib valor_aritmetico;
non terminal operacion_incremento;

/* Operaciones relacionales */
non terminal String operadorRelacional;
non terminal Atrib operando_relacional;
non terminal Atrib operacion_relacional;

/* Expresiones lógicas */
non terminal Atrib condicion_basica;
non terminal Atrib operando_logico;
non terminal Atrib condiciones_and;
non terminal Atrib condiciones_or;
non terminal Atrib condiciones_logicas;
non terminal Atrib negacion;
non terminal Atrib expresion_logica;

/* Expresiones y funciones */
non terminal Atrib expresion;
non terminal ArrayList lista_expresiones;
non terminal ArrayList expresiones;
non terminal Atrib llamada_funcion;

/* Estructuras de control */
non terminal if;
non terminal demas_if;
non terminal fin_if;
non terminal elif;
non terminal cadena_elif;
non terminal else;
non terminal while;
non terminal for;
non terminal inicio_for;
non terminal Atrib condicion_for;
non terminal incremento_for;
non terminal estructura_control;
non terminal condicion_if;
non terminal condicion_while;
non terminal cabecera_for;
non terminal ciclo_con_error;
non terminal funcion_void_invalida;

/* Sentencias y bloques */
non terminal instruccion;
non terminal sentencia_simple;
non terminal lista_instrucciones;
non terminal bloque;
non terminal break;
non terminal return;

/* Parámetros */
non terminal Simbolo parametro;             /* TS */
non terminal ArrayList lista_parametros;    /* TS */
non terminal ArrayList parametros;          /* TS */

/* Funciones */
non terminal encabezado_funcion;            /* TS */
non terminal funcion_no_void;
non terminal principal;


/* ============================================================
                    SÍMBOLO INICIAL
   ============================================================ */

start with programa;

/* ============================================================
                        VALORES
   ============================================================ */

bool ::= TRUE   {: RESULT = new Atrib("bool", "true"); :}
       | FALSE  {: RESULT = new Atrib("bool", "false"); :} ;

tipo ::= INT     {: RESULT = "int";    :}
       | FLOAT   {: RESULT = "float";  :}
       | BOOL    {: RESULT = "bool";   :}
       | CHAR    {: RESULT = "char";   :}
       | STRING  {: RESULT = "string"; :}
       ;

valor_numerico ::= entero:e    {: RESULT = e;  :}
                 | flotante:f  {: RESULT = f;  :} ;

entero ::= LITERAL_INT:v
        {: Atrib a = new Atrib("int", String.valueOf(v));
           a.valor = parser.aEntero(a.lugar);
           RESULT = a; :} ;

flotante ::= LITERAL_FLOAT :v
        {: RESULT = new Atrib("float", String.valueOf(v)); :} ;

cadena_texto ::= LITERAL_STRING :v
        {: RESULT = new Atrib("string", String.valueOf(v)); :} ;

caracter_literal ::= LITERAL_CHAR :v
        {: RESULT = new Atrib("char", String.valueOf(v)); :} ;


/* ============================================================
                IDENTIFICADORES
   ============================================================ */

identificador ::= ID:id  {: RESULT = id; :} ;

/* ============================================================
                DELIMITADORES Y OPERADORES
   ============================================================ */

/* TS: ¿: abre un ámbito nuevo y :? lo cierra */
abrir_bloque  ::= OPBLOCK  {: parser.tabla.abrirAmbito();  :} ;

cerrar_bloque ::= CLBLOCK  {: parser.tabla.cerrarAmbito(); :} ;

abrir_corcheteCuadrados ::= OPBRACKET ;

cerrar_corcheteCuadrados ::= CLBRACKET ;

coma ::= COMA ;

fin_sentencia ::= TERMINATOR ;

/* Recuperación a nivel de frase: si falta el terminador », el parser lo "inserta",
lo reporta con un mensaje específico (parser.faltaTerminador) y sigue leyendo,
   sin descartar código. El modo pánico (error fin_sentencia) queda para los demás casos. */
fin_o_falta ::= TERMINATOR
              | /* falta » */  {: parser.faltaTerminador(); :} ;

/* Lo mismo para el paréntesis de cierre que va justo antes de un bloque (¿:), y para el
cierre :? de una función. Solo se hace donde no hay ambigüedad: dentro de una expresión,
o en un bloque anidado, el parser no puede saber si el cierre falta o si la expresión
   o el bloque siguen. */
cierra_paren ::= PARENCL
               | /* falta :э */  {: parser.faltaToken(":э"); :} ;

cierra_bloque_fn ::= cerrar_bloque
                   | /* falta :? */  {: parser.faltaToken(":?"); parser.tabla.cerrarAmbito(); :} ;

asignacion ::= ASIGN ;

incremento ::= INCREMENT ;

decremento ::= DECREMENT ;


/* ============================================================
                PALABRAS RESERVADAS
   ============================================================ */

palabraVal ::= VAL ;

palabraBreak ::= BREAK ;

palabraReturn ::= RETURN ;

/* principal se registra como procedimiento sin parámetros (parser.declararFuncion) */
Principal   ::= PRINCIPAL:p  {: parser.declararFuncion("principal", "void", null, pleft, pright); :} ;

/* TS: cada palabra le pone nombre al ámbito de su bloque */
palabraIf   ::= IF         {: parser.tabla.siguienteAmbito("if");    :} ;

palabraElif ::= ELIF       {: parser.tabla.siguienteAmbito("elif");  :} ;

palabraElse ::= ELSE       {: parser.tabla.siguienteAmbito("else");  :} ;

palabraWhile ::= WHILE     {: parser.tabla.siguienteAmbito("while"); :} ;

/* TS: el for abre su ámbito desde el inicio, porque la variable de
   control (val int x Ͱ 9) se declara antes del ¿: */
palabraFor  ::= FOR        {: parser.tabla.abrirAmbito("for"); parser.tabla.siguienteAmbito("cuerpo for"); :} ;

operadorPotencia ::= POT ;

leer ::= READ ;

escribir ::= WRITE ;


/* ============================================================
                        VARIABLES
TS: se declara la variable.
SEM: si lleva valor inicial, se comprueba que el tipo del valor
        coincida con el tipo de la variable (parser.asignar).
   ============================================================ */

def_variable ::=
    palabraVal INT    identificador:id fin_o_falta {: parser.declararVariable(id, "int", null, idleft, idright); :}

    | palabraVal FLOAT  identificador:id fin_o_falta {: parser.declararVariable(id, "float", null, idleft, idright); :}

    | palabraVal BOOL   identificador:id fin_o_falta {: parser.declararVariable(id, "bool", null, idleft, idright); :}

    | palabraVal CHAR   identificador:id fin_o_falta {: parser.declararVariable(id, "char", null, idleft, idright); :}

    | palabraVal STRING identificador:id fin_o_falta {: parser.declararVariable(id, "string", null, idleft, idright); :}

    | palabraVal INT    identificador:id asignacion:a expresion:e fin_o_falta {: parser.declararVariable(id, "int", parser.textoValor(aleft, aright), idleft, idright); parser.asignar("ASG-1", id, "int", e, idleft, idright); :}

    | palabraVal FLOAT  identificador:id asignacion:a expresion:e fin_o_falta {: parser.declararVariable(id, "float", parser.textoValor(aleft, aright), idleft, idright);  parser.asignar("ASG-1", id, "float", e, idleft, idright); :}
    
    | palabraVal BOOL   identificador:id asignacion:a expresion:e fin_o_falta {: parser.declararVariable(id, "bool", parser.textoValor(aleft, aright), idleft, idright); parser.asignar("ASG-1", id, "bool", e, idleft, idright); :}
    
    | palabraVal CHAR   identificador:id asignacion:a expresion:e fin_o_falta {: parser.declararVariable(id, "char", parser.textoValor(aleft, aright), idleft, idright);  parser.asignar("ASG-1", id, "char", e, idleft, idright); :}

    | palabraVal STRING identificador:id asignacion:a expresion:e fin_o_falta {: parser.declararVariable(id, "string", parser.textoValor(aleft, aright), idleft, idright); parser.asignar("ASG-1", id, "string", e, idleft, idright); :}
    ;

/* SEM: asignar a una variable que ya existe. El tipo de la variable se
   lee de la tabla de símbolos; si no está declarada, usar() devuelve null. */
asignacion_variable ::= identificador:id asignacion expresion:e fin_o_falta
                        {: Simbolo s = parser.usar(id, idleft, idright); if (s != null) { parser.asignar("ASG-2", id, s.tipo, e, idleft, idright); } :} ;

lista_globales ::= /* vacío */
    | def_variable lista_globales
    | creacion_arreglo lista_globales
    | error fin_sentencia lista_globales
    ;


/* ============================================================
                    ENTRADA Y SALIDA
   ============================================================ */

/* SEM: read recibe UN solo destino: una variable o un elemento de arreglo
   de tipo int, float o char (parser.leer). */
lectura ::= leer PARENOP identificador:id PARENCL fin_o_falta {: Simbolo s = parser.usar(id, idleft, idright); if (s != null) { parser.leer(new Atrib(s.tipo, id), idleft, idright); } :}
        
        | leer PARENOP acceso_arreglo:a PARENCL fin_o_falta {: parser.leer(a, aleft, aright); :} ;

/* SEM: write recibe UN solo valor, que debe ser de tipo int, float o string
(parser.escribir). Acepta una expresión aritmética (el ejemplo2 del profe
escribe -6//7) o un bool; si el tipo no sirve, escribir() lo reporta. */
escritura ::= escribir PARENOP valor_escritura:v PARENCL fin_o_falta {: parser.escribir(v, vleft, vright); :} ;

valor_escritura ::= expresion_aritmetica:e  {: RESULT = e; :}
                | bool:b                  {: RESULT = b; :} ;

/* ============================================================
                ARREGLOS
   ============================================================ */

indice ::= expresion_aritmetica:e  {: RESULT = e; :} ;

acceso_arreglo ::= identificador:id abrir_corcheteCuadrados indice:i cerrar_corcheteCuadrados
                {: Simbolo s = parser.usarArreglo(id, idleft, idright); RESULT = parser.elemento(s, id, i, idleft, idright); :} ;

creacion_arreglo ::= arreglo_con_tamano | arreglo_con_tamano_valores | arreglo_sin_tamano_valores ;

/* TS: las llaves de la lista de valores usan OPBLOCK/CLBLOCK directo,
   para que no abran un ámbito nuevo */
arreglo_con_tamano ::=
    palabraVal INT   identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c fin_o_falta
    {: parser.declararArreglo(id, "int", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), 0, null, idleft, idright);
    parser.arreglo(id, "int", i, null, idleft, idright); :}
    
    | palabraVal FLOAT identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c fin_o_falta
    {: parser.declararArreglo(id, "float", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), 0, null, idleft, idright);
    parser.arreglo(id, "float", i, null, idleft, idright); :};

arreglo_con_tamano_valores ::=
    palabraVal INT   identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_o_falta
    {: parser.declararArreglo(id, "int", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "int", i, n, idleft, idright); :}

    | palabraVal FLOAT identificador:id abrir_corcheteCuadrados:a indice:i cerrar_corcheteCuadrados:c asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_o_falta
    {: parser.declararArreglo(id, "float", parser.tamanoTexto(i, parser.textoEntre(aleft, aright, cleft, cright)), n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "float", i, n, idleft, idright); :}
    ;

arreglo_sin_tamano_valores ::=
    palabraVal INT   identificador:id abrir_corcheteCuadrados cerrar_corcheteCuadrados asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_o_falta
    {: parser.declararArreglo(id, "int", null, n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "int", null, n, idleft, idright); :}
    
    | palabraVal FLOAT identificador:id abrir_corcheteCuadrados cerrar_corcheteCuadrados asignacion OPBLOCK:b lista_arreglo:n CLBLOCK:e fin_o_falta
    {: parser.declararArreglo(id, "float", null, n.size(), "¿: " + parser.textoEntre(bleft, bright, eleft, eright) + " :?", idleft, idright);
        parser.arreglo(id, "float", null, n, idleft, idright); :}
    ;


/* SEM: la lista guarda cada valor con su tipo (Atrib). El tamaño de la lista es n.size() */
lista_arreglo ::= inicio_lista_arreglo:l  {: RESULT = l; :} ;

inicio_lista_arreglo ::= expresion_aritmetica:e continuacion_lista_arreglo:l {: l.add(0, e); RESULT = l; :} ;

continuacion_lista_arreglo ::= coma expresion_aritmetica:e continuacion_lista_arreglo:l {: l.add(0, e); RESULT = l; :}
                            
                            | /* vacío */  {: RESULT = new ArrayList(); :} ;

modificacion_arreglo ::= acceso_arreglo:a asignacion expresion:e fin_o_falta
                        {: parser.asignar("ARR-8", a.lugar, a.tipo, e, aleft, aright); :} ;


/* ============================================================
                OPERACIONES ARITMÉTICAS
   Precedencia (mayor a menor): pot, + -, * / //, mod
   ============================================================ */

operador_suma ::= PLUS   {: RESULT = "+"; :}
                | MINUS  {: RESULT = "-"; :} ;

operador_multiplicacion ::= MULTIPLY   {: RESULT = "*";  :}
                        | FLOATDIV   {: RESULT = "/";  :}
                        | ENTIREDIV  {: RESULT = "//"; :} ;

expresion_aritmetica ::= expresion_mod:e  {: RESULT = e; :} ;

expresion_mod ::= expresion_mod:a MOD:m expresion_multiplicacion:b {: RESULT = parser.aritmetica(a, "mod", b, mleft, mright); :}
                | expresion_multiplicacion:e  {: RESULT = e; :} ;

expresion_multiplicacion ::= expresion_multiplicacion:a operador_multiplicacion:op expresion_suma:b {: RESULT = parser.aritmetica(a, op, b, opleft, opright); :}
                        | expresion_suma:e  {: RESULT = e; :} ;

expresion_suma ::= expresion_suma:a operador_suma:op expresion_unaria:b {: RESULT = parser.aritmetica(a, op, b, opleft, opright); :}
                | expresion_unaria:e  {: RESULT = e; :} ;

expresion_unaria ::= MINUS valor_numerico:v  {: RESULT = parser.negativo(v); :}
                | expresion_potencia:e    {: RESULT = e; :} ;

expresion_potencia ::= valor_aritmetico:e  {: RESULT = e; :}
                    | valor_aritmetico:a operadorPotencia:p exponente:b {: RESULT = parser.aritmetica(a, "pot", b, pleft, pright); :} ;

exponente ::= valor_aritmetico:e        {: RESULT = e; :}
            | MINUS valor_numerico:v    {: RESULT = parser.negativo(v); :} ;

valor_aritmetico ::= valor_numerico:v   {: RESULT = v; :}
                |  identificador:id
                    {: Simbolo s = parser.usar(id, idleft, idright);
                        if (s == null) { RESULT = new Atrib("error", id); }
                        else           { RESULT = new Atrib(s.tipo, id); } :}
                | acceso_arreglo:a     {: RESULT = a; :}
                | llamada_funcion:c    {: RESULT = c; :}
                | cadena_texto:c       {: RESULT = c; :}
                | caracter_literal:c   {: RESULT = c; :}
                | PARENOP expresion_aritmetica:e PARENCL  {: RESULT = e; :} ;

/* SEM: ++ y -- solo se aplican a variables int o float (parser.incrementar) */
operacion_incremento ::= identificador:id incremento {: parser.incrementar(parser.usar(id, idleft, idright), id, "++", idleft, idright); :}
                    | identificador:id decremento
                        {: parser.incrementar(parser.usar(id, idleft, idright), id, "--", idleft, idright); :} ;


/* ============================================================
                OPERACIONES RELACIONALES
   ============================================================ */

operadorRelacional ::= LT     {: RESULT = "<";  :}
                    | GT     {: RESULT = ">";  :}
                    | LTE    {: RESULT = "<="; :}
                    | GTE    {: RESULT = ">="; :}
                    | EQUAL  {: RESULT = "=="; :}
                    | NEQ    {: RESULT = "!="; :} ;

operando_relacional ::= valor_aritmetico:v  {: RESULT = v; :}
                    | bool:b              {: RESULT = b; :}
                    | abrir_corcheteCuadrados expresion:e cerrar_corcheteCuadrados  {: RESULT = e; :} ;

operacion_relacional ::= operando_relacional:a operadorRelacional:op operando_relacional:b
                        {: RESULT = parser.relacional(a, op, b, opleft, opright); :} ;


/* ============================================================
            EXPRESIONES LÓGICAS
   ============================================================ */

condicion_basica ::= PARENOP operacion_relacional:e PARENCL  {: RESULT = e; :}
                | PARENOP bool:e PARENCL                  {: RESULT = e; :}
                | PARENOP condicion_basica:e PARENCL      {: RESULT = e; :}
                | condiciones_logicas:e                   {: RESULT = e; :}
                | negacion:e                              {: RESULT = e; :} ;

operando_logico ::= condicion_basica:e                       {: RESULT = e; :}
                | PARENOP expresion_aritmetica:e PARENCL   {: RESULT = e; :} ;

condiciones_and ::= operando_logico:a AND:o operando_logico:b
                    {: RESULT = parser.logica(a, "and", b, oleft, oright); :}
                | condiciones_and:a AND:o operando_logico:b
                    {: RESULT = parser.logica(a, "and", b, oleft, oright); :} ;

condiciones_or ::= operando_logico:a OR:o operando_logico:b {: RESULT = parser.logica(a, "or", b, oleft, oright); :}
                | condiciones_and:a OR:o operando_logico:b {: RESULT = parser.logica(a, "or", b, oleft, oright); :}
                | operando_logico:a OR:o condiciones_and:b {: RESULT = parser.logica(a, "or", b, oleft, oright); :}
                | condiciones_and:a OR:o condiciones_and:b {: RESULT = parser.logica(a, "or", b, oleft, oright); :}
                | condiciones_or:a OR:o operando_logico:b {: RESULT = parser.logica(a, "or", b, oleft, oright); :}
                | condiciones_or:a OR:o condiciones_and:b {: RESULT = parser.logica(a, "or", b, oleft, oright); :} ;

condiciones_logicas ::= PARENOP condiciones_and:e PARENCL  {: RESULT = e; :}
                    | PARENOP condiciones_or:e PARENCL   {: RESULT = e; :} ;

negacion ::= NOT:n condicion_basica:e  {: RESULT = parser.negacion(e, nleft, nright); :} ;

expresion_logica ::= condiciones_and:e  {: RESULT = e; :}
                | condiciones_or:e   {: RESULT = e; :}
                | negacion:e         {: RESULT = e; :} ;

condicion_control ::= operacion_relacional:e                   {: RESULT = e; :}
                    | condiciones_and:e                        {: RESULT = e; :}
                    | condiciones_or:e                         {: RESULT = e; :}
                    | negacion:e                               {: RESULT = e; :}
                    | bool:e                                   {: RESULT = e; :}
                    | valor_aritmetico:e                       {: RESULT = e; :}
                    | PARENOP operacion_relacional:e PARENCL   {: RESULT = e; :}
                    | PARENOP bool:e PARENCL                   {: RESULT = e; :} ;


/* ============================================================
                EXPRESIONES Y FUNCIONES
   ============================================================ */

expresion ::= expresion_aritmetica:e  {: RESULT = e; :}
            | operacion_relacional:r  {: RESULT = r; :}
            | expresion_logica:l      {: RESULT = l; :}
            | bool:b                  {: RESULT = b; :} ;

/* SEM: los argumentos de una llamada se juntan en una lista, cada uno con su tipo */
lista_expresiones ::= /* vacío */  {: RESULT = new ArrayList(); :}
                    | expresiones:l  {: RESULT = l; :} ;

expresiones ::= expresion:e
                {: ArrayList l = new ArrayList(); l.add(e); RESULT = l; :}
            | expresion:e coma expresiones:l
                {: l.add(0, e); RESULT = l; :} ;

llamada_funcion ::= identificador:id PARENOP lista_expresiones:args PARENCL
                    {: Simbolo f = parser.usarFuncion(id, idleft, idright);
                    RESULT = parser.llamada(f, id, args, idleft, idright); :} ;


/* ============================================================
                ESTRUCTURAS DE CONTROL
   ============================================================ */

/* SEM: la condición de un if y de un elif va entre paréntesis y debe ser bool */
condicion_if ::= PARENOP condicion_control:c cierra_paren {: parser.condicion("CON-1", c, cleft, cright); :} ;

if ::= palabraIf condicion_if abrir_bloque bloque cerrar_bloque demas_if
    | palabraIf negacion abrir_bloque bloque cerrar_bloque demas_if
    | palabraIf error abrir_bloque bloque cerrar_bloque demas_if ;

demas_if ::= cadena_elif fin_if | fin_if ;

fin_if ::= else | /* vacío */ ;

elif ::= palabraElif condicion_if abrir_bloque bloque cerrar_bloque
    | palabraElif error abrir_bloque bloque cerrar_bloque ;

cadena_elif ::= elif | elif cadena_elif ;

else ::= palabraElse abrir_bloque bloque cerrar_bloque
    | palabraElse error abrir_bloque bloque cerrar_bloque ;

/* SEM: while y for cuentan los ciclos activos (para validar break) y
   revisan que su condición sea bool */
condicion_while ::= PARENOP condicion_control:c cierra_paren
                    {: parser.condicion("CON-2", c, cleft, cright); parser.entrarCiclo(); :} ;

ciclo_con_error ::= error {: parser.entrarCiclo(); :} ;

while ::= palabraWhile condicion_while abrir_bloque bloque cerrar_bloque {: parser.salirCiclo(); :}
        | palabraWhile ciclo_con_error abrir_bloque bloque cerrar_bloque {: parser.salirCiclo(); :}
        ;

cabecera_for ::= PARENOP inicio_for fin_sentencia condicion_for:c fin_sentencia incremento_for cierra_paren
                {: parser.condicion("CON-3", c, cleft, cright); parser.entrarCiclo(); :} ;

/* TS: al terminar el for se cierra el ámbito que abrió palabraFor */
for ::= palabraFor cabecera_for abrir_bloque bloque cerrar_bloque
        {: parser.salirCiclo(); parser.tabla.cerrarAmbito(); :}
    | palabraFor ciclo_con_error abrir_bloque bloque cerrar_bloque
        {: parser.salirCiclo(); parser.tabla.cerrarAmbito(); :} ;

/* SEM: el valor inicial y el incremento con asignación deben tener el tipo de la variable */
inicio_for ::= /* vacío */
            | identificador:id asignacion expresion:e
            {: Simbolo s = parser.usar(id, idleft, idright);
                if (s != null) { parser.asignar("CON-4", id, s.tipo, e, idleft, idright); } :}
            | palabraVal tipo:t identificador:id asignacion:a expresion:e
            {: parser.declararVariable(id, t, parser.textoDesde(aleft, aright), idleft, idright);
                parser.asignar("CON-4", id, t, e, idleft, idright); :} ;

condicion_for ::= operacion_relacional:e                  {: RESULT = e; :}
                | expresion_logica:e                      {: RESULT = e; :}
                | bool:e                                  {: RESULT = e; :}
                | valor_aritmetico:e                      {: RESULT = e; :}
                | PARENOP operacion_relacional:e PARENCL  {: RESULT = e; :}
                | PARENOP bool:e PARENCL                  {: RESULT = e; :} ;

incremento_for ::= /* vacío */
                | operacion_incremento
                | expresion_aritmetica
                | identificador:id asignacion expresion:e
                {: Simbolo s = parser.usar(id, idleft, idright);
                    if (s != null) { parser.asignar("CON-4", id, s.tipo, e, idleft, idright); } :} ;

estructura_control ::= if | while | for ;


/* ============================================================
                SENTENCIAS Y BLOQUES
   ============================================================ */

/* SEM: break solo dentro de un ciclo (parser.validarBreak) */
break ::= palabraBreak:b {: parser.validarBreak(bleft, bright); :} ;

return ::= palabraReturn:r fin_sentencia
        {: parser.retorno(null, rleft, rright); :}
        | palabraReturn:r expresion:e fin_o_falta
        {: parser.retorno(e, rleft, rright); :} ;

instruccion ::= sentencia_simple | estructura_control ;

sentencia_simple ::=
    asignacion_variable
    | def_variable
    | creacion_arreglo
    | modificacion_arreglo
    | lectura
    | escritura
    | operacion_incremento
    | llamada_funcion fin_o_falta
    | break fin_o_falta
    | return
    | error fin_sentencia
    ;

lista_instrucciones ::= instruccion | instruccion lista_instrucciones ;

bloque ::= /* vacío */ | lista_instrucciones ;


/* ============================================================
                    PARÁMETROS
   ============================================================ */

parametro ::= tipo:t identificador:id
            {: RESULT = new Simbolo(id, t, Simbolo.PARAMETRO, idleft, idright); :} ;

lista_parametros ::= /* vacío */      {: RESULT = new ArrayList(); :}
                | parametros:l     {: RESULT = l; :} ;

parametros ::= parametro:p {: ArrayList l = new ArrayList(); l.add(p); RESULT = l; :}
            | parametro:p coma parametros:l{: l.add(0, p); RESULT = l; :} ;


/* ============================================================
                        FUNCIONES
   ============================================================ */

/* Las funciones devuelven int, float, char o bool y reciben parámetros con tipo.
   El encabezado se reduce ANTES del cuerpo, así la función ya existe
   (permite recursión) y sus parámetros entran al ámbito del cuerpo. */
encabezado_funcion ::= tipo:t identificador:id PARENOP lista_parametros:p cierra_paren
                    {: parser.declararFuncion(id, t, p, idleft, idright); :} ;

funcion_no_void ::= encabezado_funcion abrir_bloque bloque cierra_bloque_fn {: parser.finFuncion(); :}
                | tipo error abrir_bloque bloque cerrar_bloque ;

/* void solo puede ser la función principal: un void con otro nombre es un
   error sintáctico (modo pánico: se descarta hasta el ¿: y se sigue) */
funcion_void_invalida ::= VOID error abrir_bloque bloque cerrar_bloque ;


/* ============================================================
                        PRINCIPAL
   ============================================================ */

principal ::= VOID Principal PARENOP cierra_paren abrir_bloque bloque cierra_bloque_fn ;


/* ============================================================
                UNIDADES DEL PROGRAMA
   ============================================================ */

/* Las funciones y principal pueden ir en cualquier orden. Que haya exactamente
una principal se comprueba al final del programa (parser.finPrograma): si falta
   se reporta PRG-1, y si se repite, el nombre repetido (TS-1). */
unidades_programa ::= /* vacío */
                    | unidad unidades_programa ;

unidad ::= funcion_no_void | principal | funcion_void_invalida ;


/* ============================================================
                        PROGRAMA
   ============================================================ */

programa ::= lista_globales unidades_programa  {: parser.finPrograma(); :} ;
