import java_cup.runtime.*;
import java.util.ArrayList;

/* ============================================================
   PARSER.CUP
   Revisa que el programa este bien escrito y tenga sentido.
   Aqui estan las reglas del lenguaje, las validaciones y las
   llamadas al generador de codigo intermedio.
   ============================================================ */

parser code {:

    /* ============================================================
       DATOS DEL PARSER
       ============================================================ */

    /* Tabla de simbolos: guarda las variables, arreglos y funciones, y los errores semanticos. */
    public TablaSimbolos tabla = new TablaSimbolos();

    /* Generador: escribe el codigo intermedio. */
    public Generador gen = new Generador();

    /* Todos los tokens que el parser ya leyo, en orden.
       Sirven para recuperar el texto de un valor o de un tamano. */
    private final ArrayList<Symbol> tokensLeidos = new ArrayList<Symbol>();

    /* Datos de la funcion que se esta leyendo, para revisar sus return. */
    public String tipoFuncionActual = null;
    public String nombreFuncionActual = null;
    private boolean funcionTieneReturn = false;
    private int lineaFuncionActual = 0;
    private int columnaFuncionActual = 0;

    /* Cantidad de while o for abiertos en este momento (para revisar el break). */
    private int ciclosAbiertos = 0;


    /* ============================================================
       LECTURA DE TOKENS Y TEXTO
       ============================================================ */

    /* Nombre: scan
       Descripcion: pide el siguiente token y lo guarda en la lista.
       Objetivo: recordar todo lo que se ha leido.
       Salida: el token leido. */
    @Override
    public Symbol scan() throws Exception {
        Symbol token = super.scan();
        tokensLeidos.add(token);
        return token;
    }

    /* Nombre: buscarToken
       Descripcion: busca un token por su linea y su columna, de atras hacia adelante.
       Objetivo: saber en que posicion de la lista esta ese token.
       Salida: la posicion del token, o -1 si no lo encuentra. */
    private int buscarToken(int linea, int columna, int desdePosicion) {
        for (int i = desdePosicion; i >= 0; i--) {
            Symbol token = tokensLeidos.get(i);
            if (token.left == linea && token.right == columna) {
                return i;
            }
        }
        return -1;
    }

    /* Nombre: textoEntre
       Descripcion: junta el texto de los tokens que hay entre dos posiciones.
       Objetivo: saber que se escribio entre dos simbolos.
       Salida: el texto, o null si no encuentra las posiciones. */
    public String textoEntre(int lineaInicio, int columnaInicio, int lineaFin, int columnaFin) {
        int posicionFin = buscarToken(lineaFin, columnaFin, tokensLeidos.size() - 1);
        int posicionInicio = buscarToken(lineaInicio, columnaInicio, posicionFin - 1);

        if (posicionInicio < 0 || posicionFin < 0) {
            return null;
        }

        StringBuilder texto = new StringBuilder();
        for (int i = posicionInicio + 1; i < posicionFin; i++) {
            String valorToken = String.valueOf(tokensLeidos.get(i).value);
            boolean esComa = valorToken.equals(",");

            if (texto.length() > 0 && !esComa) {
                texto.append(" ");
            }
            texto.append(valorToken);
        }
        return texto.toString();
    }

    /* Nombre: textoDesde
       Descripcion: junta el texto desde una posicion hasta el ultimo token leido.
       Objetivo: saber que se escribio desde un simbolo hasta ahora.
       Salida: el texto, o null si no hay tokens. */
    public String textoDesde(int linea, int columna) {
        if (tokensLeidos.isEmpty()) {
            return null;
        }
        Symbol ultimoToken = tokensLeidos.get(tokensLeidos.size() - 1);
        return textoEntre(linea, columna, ultimoToken.left, ultimoToken.right);
    }

    /* Nombre: textoValor
       Descripcion: da el texto del valor inicial de una variable.
       Objetivo: mostrar ese valor en la tabla de simbolos.
       Salida: el texto sin el simbolo final de la sentencia. */
    public String textoValor(int linea, int columna) {
        String texto = textoDesde(linea, columna);
        if (texto != null && texto.endsWith("»")) {
            texto = texto.substring(0, texto.length() - 1).trim();
        }
        return texto;
    }

    /* Nombre: aEntero
       Descripcion: convierte un texto en un numero entero.
       Objetivo: conocer el valor de las constantes enteras.
       Salida: el numero, o null si no se puede convertir. */
    public Integer aEntero(String texto) {
        try {
            return Integer.valueOf(texto.trim());
        } catch (NumberFormatException error) {
            return null;
        }
    }


    /* ============================================================
       AYUDAS PEQUENAS
       ============================================================ */

    /* Nombre: esNumerico
       Descripcion: dice si un tipo es int o float.
       Objetivo: no repetir esta pregunta en cada regla.
       Salida: true si es int o float. */
    private boolean esNumerico(String tipo) {
        return tipo.equals("int") || tipo.equals("float");
    }

    /* Nombre: tieneError
       Descripcion: dice si un dato ya fallo antes (su tipo es error).
       Objetivo: no repetir el mismo mensaje.
       Salida: true si el dato es de tipo error. */
    private boolean tieneError(Atrib dato) {
        return dato.tipo.equals("error");
    }

    /* Nombre: sinErroresNuevos
       Descripcion: compara la cantidad de errores de ahora con la de antes.
       Objetivo: saber si una revision no encontro errores.
       Salida: true si no se guardo ningun error nuevo. */
    private boolean sinErroresNuevos(int erroresAntes) {
        return tabla.getErrores().size() == erroresAntes;
    }

    /* Nombre: reportar
       Descripcion: guarda un error semantico con el tipo de validacion que lo detecto,
                    por ejemplo "[Aritmética] no se pueden mezclar...".
       Objetivo: que Main pueda agrupar los errores por tipo de validacion.
       Salida: ninguna. */
    private void reportar(String validacion, int linea, int columna, String mensaje) {
        tabla.errorSemantico(linea, columna, "[" + validacion + "] " + mensaje);
    }


    /* ============================================================
       OPERACIONES ARITMETICAS
       ============================================================ */

    /* Nombre: aritmetica
       Descripcion: revisa los tipos de una operacion con numeros.
       Objetivo: que solo se usen int o float y que no se mezclen.
       Salida: un dato con el tipo del resultado, o de tipo error si algo fallo. */
    public Atrib aritmetica(Atrib izquierda, String operador, Atrib derecha, int linea, int columna) {

        String tipoIzquierda = izquierda.tipo;
        String tipoDerecha = derecha.tipo;

        /* Regla 1: si alguno ya fallo, no repetir el mensaje */
        if (tieneError(izquierda) || tieneError(derecha)) {
            return new Atrib("error", "?");
        }

        /* Regla 2: los dos deben ser int o float */
        if (!esNumerico(tipoIzquierda) || !esNumerico(tipoDerecha)) {
            reportar("Aritmética", linea, columna, "el operador '" + operador + "' no se puede aplicar a '"
                    + tipoIzquierda + "' y '" + tipoDerecha + "' (se requieren int o float)");
            return new Atrib("error", "?");
        }

        /* Regla 3: no se mezclan int y float */
        if (!tipoIzquierda.equals(tipoDerecha)) {
            reportar("Aritmética", linea, columna, "no se pueden mezclar '" + tipoIzquierda + "' y '"
                    + tipoDerecha + "' con el operador '" + operador + "' (tipado fuerte)");
            return new Atrib("error", "?");
        }

        /* Regla 4: la division entera solo trabaja con int */
        if (operador.equals("//") && !tipoIzquierda.equals("int")) {
            reportar("Aritmética", linea, columna, "el operador '//' requiere operandos int y recibió '"
                    + tipoIzquierda + "'");
            return new Atrib("error", "?");
        }

        /* Regla 5: la division decimal solo trabaja con float */
        if (operador.equals("/") && !tipoIzquierda.equals("float")) {
            reportar("Aritmética", linea, columna, "el operador '/' requiere operandos float y recibió '"
                    + tipoIzquierda + "'");
            return new Atrib("error", "?");
        }

        /* Regla 6: la potencia solo acepta exponente positivo */
        boolean exponenteNegativo = derecha.lugar.startsWith("-") || (derecha.valor != null && derecha.valor < 0);
        if (operador.equals("pot") && exponenteNegativo) {
            reportar("Aritmética", linea, columna, "el operador 'pot' requiere un exponente positivo");
            return new Atrib("error", "?");
        }

        /* Todo bien: el resultado tiene el tipo de los operandos.
           Si los dos son constantes enteras, tambien se calcula su valor. */
        Atrib resultado = new Atrib(tipoIzquierda, "?");
        resultado.valor = calcularConstante(izquierda, operador, derecha);
        return resultado;
    }

    /* Nombre: generarAritmetica
       Descripcion: valida una operacion y despues pide escribir su instruccion.
       Objetivo: que solo se escriba codigo de operaciones correctas.
       Salida: un dato con el tipo y el lugar del resultado. */
    public Atrib generarAritmetica(Atrib izquierda, String operador, Atrib derecha, int linea, int columna) {
        Atrib resultado = aritmetica(izquierda, operador, derecha, linea, columna);
        return gen.binaria(resultado, izquierda, operador, derecha);
    }

    /* Nombre: negativo
       Descripcion: le pone el signo menos a un numero.
       Objetivo: manejar numeros negativos y conservar su valor.
       Salida: un dato con el mismo tipo y el lugar con el signo menos. */
    public Atrib negativo(Atrib numero) {
        Atrib resultado = new Atrib(numero.tipo, "-" + numero.lugar);
        if (numero.valor != null) {
            resultado.valor = -numero.valor;
        }
        return resultado;
    }

    /* Nombre: calcularConstante
       Descripcion: calcula una operacion cuando los dos lados son enteros constantes.
       Objetivo: conocer el valor para revisar tamanos y posiciones de arreglos.
       Salida: el resultado, o null si no se puede calcular. */
    private Integer calcularConstante(Atrib izquierda, String operador, Atrib derecha) {
        if (!izquierda.tipo.equals("int") || izquierda.valor == null || derecha.valor == null) {
            return null;
        }

        long valorIzquierda = izquierda.valor;
        long valorDerecha = derecha.valor;
        long resultado;

        switch (operador) {
            case "+":
                resultado = valorIzquierda + valorDerecha;
                break;
            case "-":
                resultado = valorIzquierda - valorDerecha;
                break;
            case "*":
                resultado = valorIzquierda * valorDerecha;
                break;
            case "//":
                if (valorDerecha == 0) return null;
                resultado = valorIzquierda / valorDerecha;
                break;
            case "mod":
                if (valorDerecha == 0) return null;
                resultado = valorIzquierda % valorDerecha;
                break;
            case "pot":
                if (valorDerecha < 0 || valorDerecha > 30) return null;
                resultado = 1;
                for (long vuelta = 0; vuelta < valorDerecha; vuelta++) {
                    resultado *= valorIzquierda;
                    if (Math.abs(resultado) > Integer.MAX_VALUE) return null;
                }
                break;
            default:
                return null;
        }

        if (resultado > Integer.MAX_VALUE || resultado < Integer.MIN_VALUE) {
            return null;
        }
        return (int) resultado;
    }


    /* ============================================================
       COMPARACIONES Y OPERACIONES LOGICAS
       ============================================================ */

    /* Nombre: relacional
       Descripcion: revisa una comparacion (< > <= >= == !=).
       Objetivo: que los dos lados sean del mismo tipo y que no sean texto.
       Salida: siempre un dato de tipo bool. */
    public Atrib relacional(Atrib izquierda, String operador, Atrib derecha, int linea, int columna) {

        /* Regla 1: si alguno ya fallo, no repetir el mensaje */
        if (tieneError(izquierda) || tieneError(derecha)) {
            return new Atrib("bool", "?");
        }

        boolean izquierdaNumerica = esNumerico(izquierda.tipo);
        boolean derechaNumerica = esNumerico(derecha.tipo);
        boolean mismoTipo = izquierda.tipo.equals(derecha.tipo);
        boolean comparacionValida;

        if (operador.equals("==") || operador.equals("!=")) {
            /* Regla 2: igualdad con int, float, bool o char del mismo tipo */
            boolean tipoPermitido = izquierdaNumerica || izquierda.tipo.equals("bool") || izquierda.tipo.equals("char");
            comparacionValida = tipoPermitido && (mismoTipo || (izquierdaNumerica && derechaNumerica));
        } else {
            /* Regla 3: orden solo con numeros del mismo tipo */
            comparacionValida = izquierdaNumerica && mismoTipo;
        }

        if (!comparacionValida) {
            reportar("Comparación", linea, columna, "no se puede comparar '"
                    + izquierda.tipo + "' con '" + derecha.tipo + "' usando '" + operador + "'");
        }

        /* Regla 4: una comparacion siempre da bool, aunque haya fallado */
        return new Atrib("bool", "?");
    }

    /* Nombre: generarRelacional
       Descripcion: valida una comparacion y despues pide escribir su instruccion.
       Objetivo: que solo se escriba codigo de comparaciones correctas.
       Salida: un dato de tipo bool. */
    public Atrib generarRelacional(Atrib izquierda, String operador, Atrib derecha, int linea, int columna) {
        int erroresAntes = tabla.getErrores().size();
        Atrib resultado = relacional(izquierda, operador, derecha, linea, columna);

        boolean todoBien = sinErroresNuevos(erroresAntes) && !tieneError(izquierda) && !tieneError(derecha);
        return todoBien ? gen.binaria(resultado, izquierda, operador, derecha) : resultado;
    }

    /* Nombre: logica
       Descripcion: revisa una operacion logica (and, or).
       Objetivo: que los dos lados sean bool.
       Salida: siempre un dato de tipo bool. */
    public Atrib logica(Atrib izquierda, String operador, Atrib derecha, int linea, int columna) {

        /* Regla 1: si alguno ya fallo, no repetir el mensaje */
        if (tieneError(izquierda) || tieneError(derecha)) {
            return new Atrib("bool", "?");
        }

        /* Regla 2: los dos lados deben ser bool */
        if (!izquierda.tipo.equals("bool") || !derecha.tipo.equals("bool")) {
            reportar("Lógica", linea, columna, "el operador lógico '" + operador
                    + "' requiere operandos bool y recibió '" + izquierda.tipo + "' y '" + derecha.tipo + "'");
        }

        /* Regla 3: el resultado siempre es bool, aunque haya fallado */
        return new Atrib("bool", "?");
    }

    /* Nombre: generarLogica
       Descripcion: valida una operacion logica (and, or) y escribe su instruccion.
       Objetivo: que solo se escriba codigo de operaciones logicas correctas.
       Salida: un dato de tipo bool. */
    public Atrib generarLogica(Atrib izquierda, String operador, Atrib derecha, int linea, int columna) {
        int erroresAntes = tabla.getErrores().size();
        Atrib resultado = logica(izquierda, operador, derecha, linea, columna);

        boolean todoBien = sinErroresNuevos(erroresAntes) && !tieneError(izquierda) && !tieneError(derecha);
        return todoBien ? gen.binaria(resultado, izquierda, operador, derecha) : resultado;
    }

    /* Nombre: negacion
       Descripcion: revisa una negacion (not).
       Objetivo: que el valor sea bool.
       Salida: siempre un dato de tipo bool. */
    public Atrib negacion(Atrib valor, int linea, int columna) {

        if (tieneError(valor)) {
            return new Atrib("bool", "?");
        }

        if (!valor.tipo.equals("bool")) {
            reportar("Lógica", linea, columna, "el operador 'not' requiere un operando bool y recibió '"
                    + valor.tipo + "'");
        }

        return new Atrib("bool", "?");
    }

    /* Nombre: generarNegacion
       Descripcion: valida una negacion (not) y escribe su instruccion.
       Objetivo: que solo se escriba codigo de negaciones correctas.
       Salida: un dato de tipo bool. */
    public Atrib generarNegacion(Atrib valor, int linea, int columna) {
        int erroresAntes = tabla.getErrores().size();
        Atrib resultado = negacion(valor, linea, columna);

        boolean todoBien = sinErroresNuevos(erroresAntes) && !tieneError(valor);
        return todoBien ? gen.unaria(resultado, "not", valor) : resultado;
    }


    /* ============================================================
       ASIGNACIONES
       ============================================================ */

    /* Nombre: asignar
       Descripcion: revisa que el valor tenga el mismo tipo que la variable.
       Objetivo: no guardar un valor de un tipo en una variable de otro tipo.
       Salida: ninguna (si no coinciden, guarda un error). */
    public void asignar(String validacion, String nombre, String tipoVariable, Atrib valor, int linea, int columna) {

        /* Regla 1: si el valor o la variable ya fallaron, no repetir el mensaje */
        if (tieneError(valor) || tipoVariable.equals("error")) {
            return;
        }

        /* Regla 2: el tipo del valor debe ser igual al de la variable */
        if (!tipoVariable.equals(valor.tipo)) {
            reportar(validacion, linea, columna, "la variable '" + nombre + "' es de tipo '"
                    + tipoVariable + "' y se le da un valor de tipo '" + valor.tipo + "'");
        }
    }

    /* Nombre: generarAsignacion
       Descripcion: escribe la instruccion de guardar un valor en una variable.
       Objetivo: que el codigo intermedio tenga cada asignacion.
       Salida: ninguna (solo escribe si el valor no fallo y el tipo coincide). */
    public void generarAsignacion(String nombre, String tipoVariable, Atrib valor) {
        if (!tieneError(valor) && valor.tipo.equals(tipoVariable)) {
            gen.asignacion(nombre, valor);
        }
    }


    /* ============================================================
       ARREGLOS
       ============================================================ */

    /* Nombre: tamanoTexto
       Descripcion: da el texto del tamano de un arreglo.
       Objetivo: mostrar el tamano en la tabla de simbolos.
       Salida: el valor calculado si es constante, o el texto original. */
    public String tamanoTexto(Atrib tamano, String textoOriginal) {
        boolean tamanoConocido = tamano != null && tamano.valor != null;
        return tamanoConocido ? String.valueOf(tamano.valor) : textoOriginal;
    }

    /* Nombre: arreglo
       Descripcion: revisa la declaracion de un arreglo.
       Objetivo: que el tamano sea int y mayor que cero, y que los valores sean del tipo
                 del arreglo y no sobren.
       Salida: ninguna (si algo falla, guarda un error). */
    public void arreglo(String nombre, String tipoElementos, Atrib tamano, ArrayList valores, int linea, int columna) {

        /* Regla 1: el tamano debe ser int (si ya fallo, no repetir el mensaje) */
        Integer tamanoConocido = null;
        if (tamano != null && !tieneError(tamano)) {
            if (!tamano.tipo.equals("int")) {
                reportar("Arreglos", linea, columna, "el tamaño del arreglo '" + nombre
                        + "' debe ser int y se encontró '" + tamano.tipo + "'");
            } else if (tamano.valor != null) {
                tamanoConocido = tamano.valor;
                if (tamanoConocido <= 0) {
                    reportar("Arreglos", linea, columna, "el tamaño del arreglo '" + nombre
                            + "' debe ser mayor que 0 y es " + tamanoConocido);
                    tamanoConocido = null;
                }
            }
        }

        if (valores == null) {
            return;
        }

        /* Regla 2: todos los valores deben tener el tipo del arreglo (un solo mensaje) */
        int cantidadIncorrectos = 0;
        int posicionPrimerIncorrecto = -1;
        String tipoPrimerIncorrecto = null;
        for (int posicion = 0; posicion < valores.size(); posicion++) {
            Atrib valor = (Atrib) valores.get(posicion);
            if (!tieneError(valor) && !valor.tipo.equals(tipoElementos)) {
                cantidadIncorrectos++;
                if (posicionPrimerIncorrecto < 0) {
                    posicionPrimerIncorrecto = posicion;
                    tipoPrimerIncorrecto = valor.tipo;
                }
            }
        }
        if (cantidadIncorrectos > 0) {
            reportar("Arreglos", linea, columna, "el arreglo '" + nombre + "' es de tipo '" + tipoElementos + "' pero "
                    + cantidadIncorrectos + " de sus " + valores.size() + " valores no lo son (el primero es el elemento "
                    + posicionPrimerIncorrecto + ", de tipo '" + tipoPrimerIncorrecto + "')");
        }

        /* Regla 3: no pueden sobrar valores si el tamano se conoce */
        if (tamanoConocido != null && valores.size() > tamanoConocido) {
            reportar("Arreglos", linea, columna, "el arreglo '" + nombre + "' tiene tamaño " + tamanoConocido
                    + " pero se dieron " + valores.size() + " valores");
        }
    }

    /* Nombre: elemento
       Descripcion: revisa el uso de una posicion de un arreglo, por ejemplo notas[0].
       Objetivo: que el arreglo exista, que la posicion sea int y que no se salga del arreglo.
       Salida: un dato con el tipo de los elementos, o de tipo error. */
    public Atrib elemento(Simbolo arreglo, String nombre, Atrib posicion, int linea, int columna) {

        /* Regla 1: si no existe o no es arreglo, usarArreglo ya aviso */
        if (arreglo == null || !arreglo.categoria.equals("arreglo")) {
            return new Atrib("error", nombre);
        }

        /* Regla 2: la posicion debe ser int (si ya fallo, no repetir el mensaje) */
        if (!tieneError(posicion) && !posicion.tipo.equals("int")) {
            reportar("Arreglos", linea, columna, "el índice del arreglo '" + nombre
                    + "' debe ser int y se encontró '" + posicion.tipo + "'");
        }

        /* Regla 3: si la posicion es una constante, debe caer dentro del arreglo */
        if (posicion.valor != null) {
            int numeroPosicion = posicion.valor;
            if (numeroPosicion < 0) {
                reportar("Arreglos", linea, columna, "el índice " + numeroPosicion + " del arreglo '" + nombre
                        + "' no puede ser negativo");
            } else if (arreglo.elementos > 0 && numeroPosicion >= arreglo.elementos) {
                reportar("Arreglos", linea, columna, "el índice " + numeroPosicion + " está fuera del arreglo '" + nombre
                        + "' (índices válidos: 0 a " + (arreglo.elementos - 1) + ")");
            }
        }

        /* Regla 4: el elemento tiene el tipo del arreglo y su lugar es nombre[posicion] */
        return new Atrib(arreglo.tipo, nombre + "[" + posicion.lugar + "]");
    }

    /* Nombre: generarElemento
       Descripcion: escribe la lectura de una posicion de un arreglo en un temporal (t = a[i]).
       Objetivo: que un elemento usado dentro de una operacion sea una direccion simple.
       Salida: un dato con el tipo del elemento y el temporal como lugar. */
    public Atrib generarElemento(Atrib elemento) {
        if (tieneError(elemento)) {
            return elemento;
        }
        return new Atrib(elemento.tipo, gen.cargarElemento(elemento.tipo, elemento.lugar));
    }

    /* Nombre: generarValoresArreglo
       Descripcion: escribe los valores iniciales de un arreglo, uno por posicion.
       Objetivo: que arr[3] = {22, 10, 11} quede como arr[0] = 22, arr[1] = 10, arr[2] = 11.
       Salida: ninguna (solo escribe los valores sin error y del tipo del arreglo). */
    public void generarValoresArreglo(String nombre, String tipo, ArrayList valores) {
        if (valores == null) {
            return;
        }
        for (int posicion = 0; posicion < valores.size(); posicion++) {
            generarAsignacion(nombre + "[" + posicion + "]", tipo, (Atrib) valores.get(posicion));
        }
    }


    /* ============================================================
       FUNCIONES
       ============================================================ */

    /* Nombre: llamada
       Descripcion: revisa una llamada a funcion: cuantos datos y de que tipo.
       Objetivo: que se den los datos que la funcion pide.
       Salida: un dato con el tipo que devuelve la funcion, o de tipo error. */
    public Atrib llamada(Simbolo funcion, String nombre, ArrayList argumentos, int linea, int columna) {

        /* Regla 1: si no existe o no es funcion, usarFuncion ya aviso */
        if (funcion == null || !funcion.esFuncion()) {
            return new Atrib("error", nombre);
        }

        /* Regla 2: la cantidad de datos debe ser la misma que la de parametros */
        int cantidadEsperada = funcion.parametros.size();
        if (argumentos.size() != cantidadEsperada) {
            reportar("Funciones", linea, columna, "la función '" + nombre + "' espera " + cantidadEsperada
                    + " argumento(s) y recibió " + argumentos.size());
        } else {
            /* Regla 3: cada dato debe tener el tipo de su parametro */
            for (int posicion = 0; posicion < cantidadEsperada; posicion++) {
                Atrib argumento = (Atrib) argumentos.get(posicion);
                Simbolo parametro = (Simbolo) funcion.parametros.get(posicion);
                boolean tipoIncorrecto = !tieneError(argumento) && !parametro.tipo.equals("error")
                        && !argumento.tipo.equals(parametro.tipo);
                if (tipoIncorrecto) {
                    reportar("Funciones", linea, columna, "el argumento " + (posicion + 1) + " de '" + nombre
                            + "' debe ser '" + parametro.tipo + "' y se encontró '" + argumento.tipo + "'");
                }
            }
        }

        /* Regla 4: el resultado tiene el tipo que devuelve la funcion */
        return new Atrib(funcion.tipo, nombre);
    }

    /* Nombre: generarLlamada
       Descripcion: valida una llamada a funcion y escribe sus param y su call.
       Objetivo: que el codigo intermedio tenga cada llamada correcta. El call usa la
                 etiqueta de la funcion (tipo_nombre), igual que en su definicion.
       Salida: un dato con el tipo que devuelve la funcion y el lugar del resultado. */
    public Atrib generarLlamada(Simbolo funcion, String nombre, ArrayList argumentos, int linea, int columna) {

        int erroresAntes = tabla.getErrores().size();
        Atrib resultado = llamada(funcion, nombre, argumentos, linea, columna);

        boolean todoBien = sinErroresNuevos(erroresAntes) && funcion != null && funcion.esFuncion();
        for (Object argumento : argumentos) {
            if (tieneError((Atrib) argumento)) {
                todoBien = false;
            }
        }

        if (todoBien) {
            boolean devuelveValor = !funcion.tipo.equals("void");
            String temporal = gen.llamar(funcion.tipo + "_" + nombre, funcion.tipo, argumentos, devuelveValor);
            if (temporal != null) {
                resultado.lugar = temporal;
            }
        }

        return resultado;
    }

    /* Nombre: declararFuncion
       Descripcion: guarda una funcion en la tabla de simbolos.
       Objetivo: que no retorne string, que sus parametros no se repitan y que su nombre sea unico.
                 Ademas deja anotada la funcion actual para revisar sus return.
       Salida: ninguna. */
    public void declararFuncion(String nombre, String tipo, ArrayList parametros, int linea, int columna) {

        if (tipo.equals("string")) {
            reportar("Funciones", linea, columna, "la función '" + nombre
                    + "' no puede retornar string (solo int, float, char o bool)");
        }

        if (parametros != null) {
            for (int posicion = 1; posicion < parametros.size(); posicion++) {
                Simbolo parametro = (Simbolo) parametros.get(posicion);
                for (int anterior = 0; anterior < posicion; anterior++) {
                    Simbolo parametroAnterior = (Simbolo) parametros.get(anterior);
                    if (parametroAnterior.nombre.equals(parametro.nombre)) {
                        avisarRepetido("Funciones", parametroAnterior, parametro.nombre, parametro.linea, parametro.columna);
                        break;
                    }
                }
            }
        }

        avisarRepetido("Nombres", tabla.declararFuncion(nombre, tipo, parametros, linea, columna), nombre, linea, columna);

        tipoFuncionActual = tipo;
        nombreFuncionActual = nombre;
        funcionTieneReturn = false;
        lineaFuncionActual = linea;
        columnaFuncionActual = columna;
    }

    /* Nombre: finFuncion
       Descripcion: se llama al cerrar el cuerpo de una funcion.
       Objetivo: revisar que una funcion con tipo tenga al menos un return.
       Salida: ninguna (si falta, guarda un error). */
    public void finFuncion() {
        boolean tieneTipo = tipoFuncionActual != null && !tipoFuncionActual.equals("void");
        if (tieneTipo && !funcionTieneReturn) {
            reportar("Funciones", lineaFuncionActual, columnaFuncionActual, "la función '" + nombreFuncionActual
                    + "' debe tener al menos un return");
        }
    }

    /* Nombre: retorno
       Descripcion: revisa un return contra la funcion donde esta.
       Objetivo: que el valor devuelto sea del tipo de la funcion.
       Salida: ninguna (si todo esta bien, escribe el return). */
    public void retorno(Atrib valor, int linea, int columna) {

        funcionTieneReturn = true;

        if (tipoFuncionActual == null) {
            return;
        }
        if (valor == null) {
            gen.retorno(null);
            return;
        }

        /* Regla 1: un procedimiento void no devuelve nada */
        if (tipoFuncionActual.equals("void")) {
            reportar("Return", linea, columna, "el procedimiento '" + nombreFuncionActual
                    + "' no puede retornar un valor");
            return;
        }

        /* Regla 2: si el valor ya fallo, no repetir el mensaje */
        if (tieneError(valor)) {
            return;
        }

        /* Regla 3: el valor debe tener el tipo de la funcion */
        if (!valor.tipo.equals(tipoFuncionActual)) {
            reportar("Return", linea, columna, "la función '" + nombreFuncionActual
                    + "' debe retornar un valor de tipo " + tipoFuncionActual
                    + ", pero se recibió " + valor.tipo);
            return;
        }
        gen.retorno(valor.lugar);
    }


    /* ============================================================
       NOMBRES: DECLARAR Y USAR
       La tabla de simbolos solo guarda y busca; aqui se decide que es un error.
       ============================================================ */

    /* Nombre: avisarRepetido
       Descripcion: avisa si un nombre ya estaba declarado en el mismo bloque.
       Objetivo: no permitir dos declaraciones iguales en un bloque.
       Salida: ninguna (si estaba repetido, guarda un error). */
    private void avisarRepetido(String validacion, Simbolo simboloPrevio, String nombre, int linea, int columna) {
        if (simboloPrevio != null) {
            reportar(validacion, linea, columna, "'" + nombre
                    + "' ya fue declarado en este ámbito (línea " + simboloPrevio.linea + ")");
        }
    }

    /* Nombre: declararVariable
       Descripcion: guarda una variable en la tabla de simbolos.
       Objetivo: que cada variable quede registrada una sola vez por bloque.
       Salida: ninguna. */
    public void declararVariable(String nombre, String tipo, String valorInicial, int linea, int columna) {
        Simbolo simboloPrevio = tabla.declararVariable(nombre, tipo, valorInicial, linea, columna);
        avisarRepetido("Nombres", simboloPrevio, nombre, linea, columna);
    }

    /* Nombre: declararArreglo
       Descripcion: guarda un arreglo en la tabla de simbolos.
       Objetivo: que cada arreglo quede registrado una sola vez por bloque.
       Salida: ninguna. */
    public void declararArreglo(String nombre, String tipo, String tamano, int elementos,
                                String valores, int linea, int columna) {
        Simbolo simboloPrevio = tabla.declararArreglo(nombre, tipo, tamano, elementos, valores, linea, columna);
        avisarRepetido("Nombres", simboloPrevio, nombre, linea, columna);
    }

    /* Nombre: usar
       Descripcion: busca una variable que se esta usando.
       Objetivo: que este declarada, que no sea funcion y que no sea un arreglo sin posicion.
       Salida: el simbolo, o null si hubo un error (el error ya se guardo). */
    public Simbolo usar(String nombre, int linea, int columna) {
        Simbolo simbolo = tabla.buscar(nombre);

        if (simbolo == null) {
            reportar("Nombres", linea, columna, "'" + nombre + "' no ha sido declarado");
            return null;
        }
        if (simbolo.esFuncion()) {
            reportar("Nombres", linea, columna, "'" + nombre + "' es una función y se usa como variable");
            return null;
        }
        if (simbolo.categoria.equals(Simbolo.ARREGLO)) {
            reportar("Nombres", linea, columna, "'" + nombre + "' es un arreglo y debe usarse con un índice");
            return null;
        }
        return simbolo;
    }

    /* Nombre: usarArreglo
       Descripcion: busca un arreglo que se esta usando.
       Objetivo: que este declarado y que de verdad sea un arreglo.
       Salida: el simbolo (puede ser null o no ser arreglo; el error ya se guardo). */
    public Simbolo usarArreglo(String nombre, int linea, int columna) {
        Simbolo simbolo = tabla.buscar(nombre);

        if (simbolo == null) {
            reportar("Nombres", linea, columna, "el arreglo '" + nombre + "' no ha sido declarado");
        } else if (!simbolo.categoria.equals(Simbolo.ARREGLO)) {
            reportar("Nombres", linea, columna, "'" + nombre + "' no es un arreglo");
        }
        return simbolo;
    }

    /* Nombre: usarFuncion
       Descripcion: busca una funcion que se esta llamando.
       Objetivo: que este declarada y que de verdad sea una funcion.
       Salida: el simbolo (puede ser null o no ser funcion; el error ya se guardo). */
    public Simbolo usarFuncion(String nombre, int linea, int columna) {
        Simbolo simbolo = tabla.buscar(nombre);

        if (simbolo == null) {
            reportar("Nombres", linea, columna, "la función '" + nombre + "' no ha sido declarada");
        } else if (!simbolo.esFuncion()) {
            reportar("Nombres", linea, columna, "'" + nombre + "' no es una función");
        }
        return simbolo;
    }

    /* Nombre: finPrograma
       Descripcion: se llama al terminar de leer el programa.
       Objetivo: revisar que exista la funcion principal.
       Salida: ninguna (si falta, guarda un error). */
    public void finPrograma() {
        if (tabla.buscar("principal") != null) {
            return;
        }

        /* El error se marca en el ultimo token que tenga posicion */
        int linea = 1;
        int columna = 1;
        for (int i = tokensLeidos.size() - 1; i >= 0; i--) {
            Symbol token = tokensLeidos.get(i);
            if (token.left > 0) {
                linea = token.left;
                columna = token.right;
                break;
            }
        }
        reportar("Programa", linea, columna, "el programa debe tener una función principal");
    }


    /* ============================================================
       CONTROL: CICLOS, BREAK, CONDICIONES Y ++ --
       ============================================================ */

    /* Nombre: entrarCiclo y salirCiclo
       Descripcion: cuentan cuantos while o for estan abiertos en este momento.
       Objetivo: saber si un break esta dentro de un ciclo.
       Salida: ninguna. */
    public void entrarCiclo() {
        ciclosAbiertos++;
    }

    public void salirCiclo() {
        if (ciclosAbiertos > 0) {
            ciclosAbiertos--;
        }
    }

    /* Nombre: validarBreak
       Descripcion: revisa un break.
       Objetivo: que solo se use dentro de un while o de un for.
       Salida: ninguna (si esta afuera, guarda un error). */
    public void validarBreak(int linea, int columna) {
        if (ciclosAbiertos == 0) {
            reportar("Control", linea, columna, "break solo puede utilizarse dentro de un ciclo");
        }
    }

    /* Nombre: condicion
       Descripcion: revisa la condicion de un if, elif, while o for.
       Objetivo: que la condicion sea de tipo bool.
       Salida: ninguna (si no es bool, guarda un error). */
    public void condicion(String validacion, Atrib condicion, int linea, int columna) {

        if (condicion == null || tieneError(condicion)) {
            return;
        }

        if (!condicion.tipo.equals("bool")) {
            reportar(validacion, linea, columna, "la condición debe ser de tipo bool, pero se recibió "
                    + condicion.tipo);
        }
    }

    /* Nombre: incrementar
       Descripcion: revisa un ++ o un --.
       Objetivo: que solo se use con variables int o float.
       Salida: ninguna (si esta bien, escribe la instruccion). */
    public void incrementar(Simbolo variable, String nombre, String operador, int linea, int columna) {

        if (variable == null) {
            return;
        }

        if (!esNumerico(variable.tipo)) {
            reportar("Incremento", linea, columna, "el operador '" + operador
                    + "' solo se aplica a variables int o float y '" + nombre + "' es de tipo " + variable.tipo);
            return;
        }
        gen.incremento(variable.tipo, nombre, operador);
    }


    /* ============================================================
       ENTRADA Y SALIDA
       ============================================================ */

    /* Nombre: leer
       Descripcion: revisa una instruccion read.
       Objetivo: que se lea en una variable o posicion de tipo int, float o char.
       Salida: ninguna (si esta bien, escribe la instruccion). */
    public void leer(Atrib destino, int linea, int columna) {

        if (destino == null || tieneError(destino)) {
            return;
        }

        boolean tipoPermitido = esNumerico(destino.tipo) || destino.tipo.equals("char");
        if (!tipoPermitido) {
            reportar("Entrada/Salida", linea, columna,
                    "read solo permite valores de tipo int, float o char; se recibió " + destino.tipo);
            return;
        }
        gen.leer(destino.lugar);
    }

    /* Nombre: escribir
       Descripcion: revisa una instruccion write.
       Objetivo: que solo se escriban valores int, float o string.
       Salida: ninguna (si esta bien, escribe la instruccion). */
    public void escribir(Atrib valor, int linea, int columna) {

        if (valor == null || tieneError(valor)) {
            return;
        }

        boolean tipoPermitido = esNumerico(valor.tipo) || valor.tipo.equals("string");
        if (!tipoPermitido) {
            reportar("Entrada/Salida", linea, columna, "write no permite valores de tipo " + valor.tipo);
            return;
        }
        gen.escribir(valor.lugar);
    }


    /* ============================================================
       AVISOS DE RECUPERACION DE ERRORES
       Main reemplaza errorProduccion y tokenFaltante para guardar el aviso.
       ============================================================ */

    /* Nombre: errorProduccion
       Descripcion: avisa que el programa trae un error comun, con su mensaje.
       Objetivo: dar un mensaje exacto. Main lo reemplaza para guardarlo.
       Salida: ninguna (aqui no hace nada). */
    public void errorProduccion(int linea, int columna, String mensaje) {
    }

    /* Nombre: tokenFaltante
       Descripcion: avisa que falta un simbolo y que el parser lo puso por su cuenta.
       Objetivo: dar un mensaje exacto. Main lo reemplaza para guardarlo.
       Salida: ninguna (aqui no hace nada). */
    public void tokenFaltante(String token, int linea, int columna) {
    }

    /* Nombre: faltaTerminador
       Descripcion: avisa que falta el simbolo de fin al final de una sentencia.
       Objetivo: arreglar el error sin perder codigo.
       Salida: ninguna. */
    public void faltaTerminador() {
        faltaToken("»");
    }

    /* Nombre: faltaToken
       Descripcion: calcula donde falta un simbolo (fin de sentencia, parentesis o cierre de bloque) y lo avisa.
       Objetivo: decir la posicion exacta del simbolo que falta.
       Salida: ninguna. */
    public void faltaToken(String token) {
        int cantidadLeidos = tokensLeidos.size();
        if (cantidadLeidos < 2) {
            return;
        }

        /* El simbolo falta justo despues del penultimo token leido */
        Symbol tokenAnterior = tokensLeidos.get(cantidadLeidos - 2);
        int largoTexto = tokenAnterior.value == null ? 1 : Math.max(1, String.valueOf(tokenAnterior.value).length());
        tokenFaltante(token, tokenAnterior.left, tokenAnterior.right + largoTexto);
    }

:};


/* ============================================================
                        TERMINALES
   Son las piezas que entrega el analizador lexico.
   ============================================================ */

/* Operadores aritmeticos */
terminal INCREMENT, PLUS, DECREMENT, MINUS, MULTIPLY;
terminal ENTIREDIV, FLOATDIV, MOD, POT;

/* Operadores relacionales */
terminal LTE, GTE, EQUAL, NEQ, LT, GT;

/* Operadores logicos */
terminal AND, OR, NOT;

/* Delimitadores */
terminal OPBLOCK, CLBLOCK;
terminal PARENOP, PARENCL;
terminal OPBRACKET, CLBRACKET;
terminal TERMINATOR, ASIGN, COMA;

/* Tipos y palabras reservadas */
terminal VAL;
terminal PRINCIPAL;
terminal INT, FLOAT, BOOL, CHAR, STRING, VOID;
terminal TRUE, FALSE;

/* Estructuras de control */
terminal IF, ELIF, ELSE;
terminal WHILE, FOR;
terminal RETURN, BREAK;

/* Entrada y salida */
terminal READ, WRITE;

/* Literales e identificadores */
terminal LITERAL_INT;
terminal LITERAL_FLOAT;
terminal LITERAL_STRING;
terminal LITERAL_CHAR;
terminal String ID;                         /* el ID trae el nombre escrito */


/* ============================================================
                         NO TERMINALES
   Son las partes del lenguaje que se arman con reglas.
   Los que dicen Atrib llevan tipo y lugar del resultado.
   ============================================================ */

non terminal programa;
non terminal lista_globales;
non terminal unidades_programa;
non terminal unidad;
non terminal String tipo;

/* Valores */
non terminal Atrib valor_numerico;
non terminal Atrib entero;
non terminal Atrib flotante;
non terminal Atrib bool;
non terminal Atrib cadena_texto;
non terminal Atrib caracter_literal;
non terminal Atrib condicion_control;

/* Identificadores */
non terminal String identificador;

/* Delimitadores */
non terminal abrir_bloque;
non terminal cerrar_bloque;
non terminal abrir_corcheteCuadrados;
non terminal cerrar_corcheteCuadrados;
non terminal coma;
non terminal fin_sentencia;
non terminal fin_o_falta;
non terminal cierra_paren;
non terminal cierra_bloque_fn;
non terminal asignacion;
non terminal incremento;
non terminal decremento;

/* Palabras reservadas y operadores */
non terminal palabraVal;
non terminal palabraBreak;
non terminal palabraReturn;
non terminal Principal;
non terminal palabraIf;
non terminal palabraElif;
non terminal palabraElse;
non terminal palabraWhile;
non terminal palabraFor;
non terminal operadorPotencia;
non terminal leer;
non terminal escribir;

/* Variables */
non terminal def_variable;
non terminal asignacion_variable;

/* Entrada y salida */
non terminal lectura;
non terminal escritura;
non terminal Atrib valor_escritura;

/* Arreglos */
non terminal Atrib indice;
non terminal Atrib acceso_arreglo;
non terminal creacion_arreglo;
non terminal arreglo_con_tamano;
non terminal arreglo_con_tamano_valores;
non terminal arreglo_sin_tamano_valores;
non terminal ArrayList lista_arreglo;
non terminal ArrayList inicio_lista_arreglo;
non terminal ArrayList continuacion_lista_arreglo;
non terminal modificacion_arreglo;

/* Operaciones aritmeticas */
non terminal String operador_suma;
non terminal String operador_multiplicacion;
non terminal Atrib expresion_aritmetica;
non terminal Atrib expresion_mod;
non terminal Atrib expresion_suma;
non terminal Atrib expresion_multiplicacion;
non terminal Atrib expresion_unaria;
non terminal Atrib expresion_potencia;
non terminal Atrib exponente;
non terminal Atrib valor_aritmetico;
non terminal operacion_incremento;

/* Operaciones relacionales */
non terminal String operadorRelacional;
non terminal Atrib operando_relacional;
non terminal Atrib operacion_relacional;

/* Expresiones logicas */
non terminal Atrib condicion_basica;
non terminal Atrib operando_logico;
non terminal Atrib condiciones_and;
non terminal Atrib condiciones_or;
non terminal Atrib condiciones_logicas;
non terminal Atrib negacion;
non terminal Atrib expresion_logica;

/* Expresiones y funciones */
non terminal Atrib expresion;
non terminal ArrayList lista_expresiones;
non terminal ArrayList expresiones;
non terminal Atrib llamada_funcion;

/* Estructuras de control */
non terminal if;
non terminal demas_if;
non terminal fin_if;
non terminal elif;
non terminal cadena_elif;
non terminal else;
non terminal while;
non terminal for;
non terminal inicio_for;
non terminal Atrib condicion_for;
non terminal incremento_for;
non terminal estructura_control;
non terminal condicion_if;
non terminal negacion_if;
non terminal condicion_while;
non terminal cabecera_for;
non terminal fin_init_for;
non terminal fin_cond_for;
non terminal ciclo_con_error;
non terminal funcion_void_invalida;

/* Sentencias y bloques */
non terminal instruccion;
non terminal sentencia_simple;
non terminal lista_instrucciones;
non terminal bloque;
non terminal break;
non terminal return;

/* Parametros */
non terminal Simbolo parametro;
non terminal ArrayList lista_parametros;
non terminal ArrayList parametros;

/* Funciones */
non terminal encabezado_funcion;
non terminal funcion_no_void;
non terminal principal;


/* ============================================================
                    SIMBOLO INICIAL
   ============================================================ */

start with programa;

/* ============================================================
                        VALORES
   ============================================================ */

/* Nombre: bool
   Descripcion: los valores true y false.
   Objetivo: crear un valor de tipo bool y copiarlo a un temporal (t1 = true).
   Salida: un dato de tipo bool con el temporal como lugar. */
bool ::= TRUE   {: RESULT = parser.gen.cargar(new Atrib("bool", "true")); :}
       | FALSE  {: RESULT = parser.gen.cargar(new Atrib("bool", "false")); :} ;

/* Nombre: tipo
   Descripcion: los tipos del lenguaje (int, float, bool, char, string).
   Objetivo: saber de que tipo se declara algo.
   Salida: el nombre del tipo como texto. */
tipo ::= INT     {: RESULT = "int";    :}
       | FLOAT   {: RESULT = "float";  :}
       | BOOL    {: RESULT = "bool";   :}
       | CHAR    {: RESULT = "char";   :}
       | STRING  {: RESULT = "string"; :}
       ;

/* Nombre: valor_numerico
   Descripcion: un numero entero o decimal.
   Objetivo: agrupar los dos tipos de numero.
   Salida: un dato de tipo int o float. */
valor_numerico ::= entero:numero    {: RESULT = numero;  :}
                 | flotante:decimal  {: RESULT = decimal;  :} ;

/* Nombre: entero
   Descripcion: un numero entero escrito en el programa.
   Objetivo: crear un valor int y guardar su numero.
   Salida: un dato de tipo int con su valor. */
entero ::= LITERAL_INT:texto
        {: Atrib numero = new Atrib("int", String.valueOf(texto));
           numero.valor = parser.aEntero(numero.lugar);
           RESULT = numero; :} ;

/* Nombre: flotante
   Descripcion: un numero decimal escrito en el programa.
   Objetivo: crear un valor float.
   Salida: un dato de tipo float. */
flotante ::= LITERAL_FLOAT :texto
        {: RESULT = new Atrib("float", String.valueOf(texto)); :} ;

/* Nombre: cadena_texto
   Descripcion: un texto entre comillas.
   Objetivo: crear un valor string.
   Salida: un dato de tipo string. */
cadena_texto ::= LITERAL_STRING :texto
        {: RESULT = new Atrib("string", String.valueOf(texto)); :} ;

/* Nombre: caracter_literal
   Descripcion: una letra o simbolo entre comillas simples.
   Objetivo: crear un valor char.
   Salida: un dato de tipo char. */
caracter_literal ::= LITERAL_CHAR :texto
        {: RESULT = new Atrib("char", String.valueOf(texto)); :} ;


/* ============================================================
                 IDENTIFICADORES
   ============================================================ */

/* Nombre: identificador
   Descripcion: el nombre de una variable, arreglo o funcion.
   Objetivo: obtener ese nombre.
   Salida: el nombre como texto. */
identificador ::= ID:nombre  {: RESULT = nombre; :} ;

/* ============================================================
                DELIMITADORES Y OPERADORES
   ============================================================ */

/* Nombre: abrir_bloque
   Descripcion: el simbolo que abre un bloque.
   Objetivo: abrir un bloque nuevo en la tabla de simbolos.
   Salida: ninguna. */
abrir_bloque  ::= OPBLOCK  {: parser.tabla.abrirAmbito();  :} ;

/* Nombre: cerrar_bloque
   Descripcion: el simbolo que cierra un bloque.
   Objetivo: cerrar el bloque actual en la tabla de simbolos.
   Salida: ninguna. */
cerrar_bloque ::= CLBLOCK  {: parser.tabla.cerrarAmbito(); :} ;

/* Nombre: abrir y cerrar corchetes
   Descripcion: los simbolos de corchete usados en arreglos y comparaciones.
   Objetivo: marcar donde empieza y termina una posicion.
   Salida: ninguna. */
abrir_corcheteCuadrados ::= OPBRACKET ;

cerrar_corcheteCuadrados ::= CLBRACKET ;

/* Nombre: coma
   Descripcion: la coma que separa datos.
   Objetivo: separar valores y parametros.
   Salida: ninguna. */
coma ::= COMA ;

/* Nombre: fin_sentencia
   Descripcion: el simbolo que termina una sentencia.
   Objetivo: marcar el final de una sentencia.
   Salida: ninguna. */
fin_sentencia ::= TERMINATOR ;

/* Nombre: fin_o_falta
   Descripcion: el simbolo de fin de sentencia, o nada si se olvido.
   Objetivo: si falta, ponerlo por su cuenta, avisar y seguir leyendo sin perder codigo.
   Salida: ninguna (si falta, avisa). */
fin_o_falta ::= TERMINATOR
              | /* falta el simbolo */  {: parser.faltaTerminador(); :} ;

/* Nombre: cierra_paren
   Descripcion: el parentesis que cierra, o nada si se olvido.
   Objetivo: si falta, ponerlo por su cuenta y avisar. Se usa solo antes de abrir un bloque.
   Salida: ninguna (si falta, avisa). */
cierra_paren ::= PARENCL
               | /* falta el parentesis */  {: parser.faltaToken(":э"); :} ;

/* Nombre: cierra_bloque_fn
   Descripcion: el simbolo que cierra una funcion, o nada si se olvido.
   Objetivo: si falta, ponerlo por su cuenta, avisar y cerrar el bloque.
   Salida: ninguna (si falta, avisa). */
cierra_bloque_fn ::= cerrar_bloque
                   | /* falta el cierre */  {: parser.faltaToken(":?"); parser.tabla.cerrarAmbito(); :} ;

/* Nombre: asignacion, incremento y decremento
   Descripcion: los simbolos de asignar, de ++ y de --.
   Objetivo: reconocer esos simbolos. En el = se marca donde empieza el codigo del valor,
             para poner ahi el data# de una declaracion con valor.
   Salida: ninguna. */
asignacion ::= ASIGN  {: parser.gen.marcarAsignacion(); :} ;

incremento ::= INCREMENT ;

decremento ::= DECREMENT ;


/* ============================================================
                PALABRAS RESERVADAS
   ============================================================ */

/* Nombre: palabraVal, palabraBreak y palabraReturn
   Descripcion: las palabras val, break y return.
   Objetivo: reconocerlas dentro de otras reglas.
   Salida: ninguna. */
palabraVal ::= VAL ;

palabraBreak ::= BREAK ;

palabraReturn ::= RETURN ;

/* Nombre: Principal
   Descripcion: la palabra principal.
   Objetivo: guardar la funcion principal y escribir su etiqueta (void_principal).
   Salida: ninguna. */
Principal ::= PRINCIPAL:palabraPrincipal {: parser.declararFuncion("principal", "void", null, palabraPrincipalleft, palabraPrincipalright);
                parser.gen.etiquetaFuncion("void", "principal"); :} ;

/* Nombre: palabraIf
   Descripcion: la palabra if.
   Objetivo: ponerle nombre al bloque que viene despues y empezar el if en el codigo intermedio.
   Salida: ninguna. */
palabraIf   ::= IF         {: parser.tabla.siguienteAmbito("if");
                              parser.gen.iniciarIf(); :} ;

/* Nombre: palabraElif y palabraElse
   Descripcion: las palabras elif y else.
   Objetivo: ponerle nombre al bloque que viene despues. En el codigo intermedio, la rama
             anterior salta al final del if y aqui cae la condicion falsa.
   Salida: ninguna. */
palabraElif ::= ELIF       {: parser.tabla.siguienteAmbito("elif");
                              parser.gen.otraRama(); :} ;

palabraElse ::= ELSE       {: parser.tabla.siguienteAmbito("else");
                              parser.gen.otraRama(); :} ;

/* Nombre: palabraWhile
   Descripcion: la palabra while.
   Objetivo: ponerle nombre al bloque que viene despues y escribir la etiqueta _cond
             antes del codigo de la condicion.
   Salida: ninguna. */
palabraWhile ::= WHILE     {: parser.tabla.siguienteAmbito("while");
                              parser.gen.iniciarWhile(); :} ;

/* Nombre: palabraFor
   Descripcion: la palabra for.
   Objetivo: abrir el bloque del for desde el inicio, porque su variable se declara antes del bloque.
             Tambien escribe la etiqueta _init antes de la inicializacion.
   Salida: ninguna. */
palabraFor  ::= FOR        {: parser.tabla.abrirAmbito("for");
                              parser.tabla.siguienteAmbito("cuerpo for");
                              parser.gen.iniciarFor(); :} ;

/* Nombre: operadorPotencia, leer y escribir
   Descripcion: las palabras pot, read y write.
   Objetivo: reconocerlas dentro de otras reglas.
   Salida: ninguna. */
operadorPotencia ::= POT ;

leer ::= READ ;

escribir ::= WRITE ;


/* ============================================================
                         VARIABLES
   ============================================================ */

/* Nombre: def_variable
   Descripcion: crear una variable, con valor inicial o sin el.
   Objetivo: guardarla en la tabla de simbolos y revisar que el valor sea de su tipo.
             Tambien reconoce errores comunes (sin tipo o con void) para dar un mensaje exacto.
   Salida: ninguna (guarda la variable y escribe su asignacion). */
def_variable ::=
      palabraVal INT    identificador:nombre fin_o_falta
      {: parser.declararVariable(nombre, "int", null, nombreleft, nombreright);
         parser.gen.declarar("int", nombre); :}
    | palabraVal FLOAT  identificador:nombre fin_o_falta
      {: parser.declararVariable(nombre, "float", null, nombreleft, nombreright);
         parser.gen.declarar("float", nombre); :}
    | palabraVal BOOL   identificador:nombre fin_o_falta
      {: parser.declararVariable(nombre, "bool", null, nombreleft, nombreright);
         parser.gen.declarar("bool", nombre); :}
    | palabraVal CHAR   identificador:nombre fin_o_falta
      {: parser.declararVariable(nombre, "char", null, nombreleft, nombreright);
         parser.gen.declarar("char", nombre); :}
    | palabraVal STRING identificador:nombre fin_o_falta
      {: parser.declararVariable(nombre, "string", null, nombreleft, nombreright);
         parser.gen.declarar("string", nombre); :}
    | palabraVal INT    identificador:nombre asignacion:signoAsigna expresion:valor fin_o_falta
      {: parser.declararVariable(nombre, "int", parser.textoValor(signoAsignaleft, signoAsignaright), nombreleft, nombreright);
         parser.gen.declararAntesDelValor("int", nombre);
         parser.asignar("Asignación", nombre, "int", valor, nombreleft, nombreright); parser.generarAsignacion(nombre, "int", valor); :}
    | palabraVal FLOAT  identificador:nombre asignacion:signoAsigna expresion:valor fin_o_falta
      {: parser.declararVariable(nombre, "float", parser.textoValor(signoAsignaleft, signoAsignaright), nombreleft, nombreright);
         parser.gen.declararAntesDelValor("float", nombre);
         parser.asignar("Asignación", nombre, "float", valor, nombreleft, nombreright); parser.generarAsignacion(nombre, "float", valor); :}
    | palabraVal BOOL   identificador:nombre asignacion:signoAsigna expresion:valor fin_o_falta
      {: parser.declararVariable(nombre, "bool", parser.textoValor(signoAsignaleft, signoAsignaright), nombreleft, nombreright);
         parser.gen.declararAntesDelValor("bool", nombre);
         parser.asignar("Asignación", nombre, "bool", valor, nombreleft, nombreright); parser.generarAsignacion(nombre, "bool", valor); :}
    | palabraVal CHAR   identificador:nombre asignacion:signoAsigna expresion:valor fin_o_falta
      {: parser.declararVariable(nombre, "char", parser.textoValor(signoAsignaleft, signoAsignaright), nombreleft, nombreright);
         parser.gen.declararAntesDelValor("char", nombre);
         parser.asignar("Asignación", nombre, "char", valor, nombreleft, nombreright); parser.generarAsignacion(nombre, "char", valor); :}
    | palabraVal STRING identificador:nombre asignacion:signoAsigna expresion:valor fin_o_falta
      {: parser.declararVariable(nombre, "string", parser.textoValor(signoAsignaleft, signoAsignaright), nombreleft, nombreright);
         parser.gen.declararAntesDelValor("string", nombre);
         parser.asignar("Asignación", nombre, "string", valor, nombreleft, nombreright); parser.generarAsignacion(nombre, "string", valor); :}
    | palabraVal identificador:nombre asignacion expresion fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "falta el tipo en la declaración de '" + nombre + "' (int, float, bool, char o string)");
         parser.declararVariable(nombre, "error", null, nombreleft, nombreright); :}
    | palabraVal identificador:nombre fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "falta el tipo en la declaración de '" + nombre + "' (int, float, bool, char o string)");
         parser.declararVariable(nombre, "error", null, nombreleft, nombreright); :}
    | palabraVal VOID identificador:nombre asignacion expresion fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "una variable no puede ser de tipo void ('" + nombre + "'); void solo se usa en principal");
         parser.declararVariable(nombre, "error", null, nombreleft, nombreright); :}
    | palabraVal VOID identificador:nombre fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "una variable no puede ser de tipo void ('" + nombre + "'); void solo se usa en principal");
         parser.declararVariable(nombre, "error", null, nombreleft, nombreright); :}
    ;

/* Nombre: asignacion_variable
   Descripcion: guardar un valor en una variable que ya existe.
   Objetivo: revisar que exista y que el valor sea de su mismo tipo.
   Salida: ninguna (escribe la asignacion si todo esta bien). */
asignacion_variable ::=
    identificador:nombre asignacion expresion:valor fin_o_falta
    {:
        Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);

        if (simbolo != null) {
            parser.asignar("Asignación", nombre, simbolo.tipo, valor,
                        nombreleft, nombreright);

            parser.generarAsignacion(nombre, simbolo.tipo, valor);
        }
    :}
    ;

/* Nombre: lista_globales
   Descripcion: las variables y arreglos que se declaran antes de las funciones.
   Objetivo: permitir datos globales. Si hay un error, salta hasta el fin de la sentencia.
   Salida: ninguna. */
lista_globales ::= /* vacio */
    | def_variable lista_globales
    | creacion_arreglo lista_globales
    | error fin_sentencia lista_globales
    ;


/* ============================================================
                     ENTRADA Y SALIDA
   ============================================================ */

/* Nombre: lectura
   Descripcion: la instruccion read, con una variable o una posicion de arreglo.
   Objetivo: revisar el destino. Si faltan los parentesis, da un mensaje exacto.
   Salida: ninguna (escribe el read si todo esta bien). */
lectura ::= leer PARENOP identificador:nombre PARENCL fin_o_falta
            {: Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);
               if (simbolo != null) { parser.leer(new Atrib(simbolo.tipo, nombre), nombreleft, nombreright); } :}
          | leer PARENOP acceso_arreglo:elemento PARENCL fin_o_falta
            {: parser.leer(elemento, elementoleft, elementoright); :}
          | leer identificador:nombre fin_o_falta
            {: parser.errorProduccion(nombreleft, nombreright, "read necesita su argumento entre paréntesis: read є: " + nombre + " :э»");
               Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);
               if (simbolo != null) { parser.leer(new Atrib(simbolo.tipo, nombre), nombreleft, nombreright); } :}
          ;

/* Nombre: escritura
   Descripcion: la instruccion write, con un solo valor.
   Objetivo: revisar que el valor sea int, float o string. Si faltan los parentesis, da un mensaje exacto.
   Salida: ninguna (escribe el write si todo esta bien). */
escritura ::= escribir PARENOP valor_escritura:valor PARENCL fin_o_falta
              {: parser.escribir(valor, valorleft, valorright); :}
            | escribir identificador:nombre fin_o_falta
              {: parser.errorProduccion(nombreleft, nombreright, "write necesita su argumento entre paréntesis: write є: " + nombre + " :э»");
                 Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);
                 if (simbolo != null) { parser.escribir(new Atrib(simbolo.tipo, nombre), nombreleft, nombreright); } :} ;

/* Nombre: valor_escritura
   Descripcion: lo que se puede escribir con write: una operacion o un bool.
   Objetivo: dar el valor a escribir.
   Salida: un dato con su tipo y lugar. */
valor_escritura ::= expresion_aritmetica:valor  {: RESULT = valor; :}
                  | bool:valorBool                  {: RESULT = valorBool; :} ;

/* ============================================================
                 ARREGLOS
   ============================================================ */

/* Nombre: indice
   Descripcion: la posicion que se pide en un arreglo.
   Objetivo: aceptar cualquier operacion con numeros como posicion. Si es un numero o una
             variable sola, se usa directo (edades[2]) sin copiarla a un temporal.
   Salida: un dato con su tipo y valor. */
indice ::= expresion_aritmetica:valor  {: RESULT = parser.gen.sinCarga(valor); :} ;

/* Nombre: acceso_arreglo
   Descripcion: usar una posicion de un arreglo, por ejemplo notas[0].
   Objetivo: revisar que el arreglo exista y que la posicion sea valida.
   Salida: un dato con el tipo de los elementos. */
acceso_arreglo ::= identificador:nombre abrir_corcheteCuadrados indice:posicion cerrar_corcheteCuadrados
                   {: Simbolo simbolo = parser.usarArreglo(nombre, nombreleft, nombreright);
                      RESULT = parser.elemento(simbolo, nombre, posicion, nombreleft, nombreright); :} ;

/* Nombre: creacion_arreglo
   Descripcion: las tres formas de crear un arreglo.
   Objetivo: agrupar las formas: con tamano, con tamano y valores, y solo con valores.
   Salida: ninguna. */
creacion_arreglo ::= arreglo_con_tamano | arreglo_con_tamano_valores | arreglo_sin_tamano_valores ;

/* Nombre: arreglo_con_tamano
   Descripcion: crear un arreglo indicando solo su tamano.
   Objetivo: guardarlo y revisar su tamano. Un arreglo de bool, char o string da un mensaje exacto.
   Salida: ninguna. */
arreglo_con_tamano ::=
      palabraVal INT   identificador:nombre abrir_corcheteCuadrados:corcheteAbre indice:tamano cerrar_corcheteCuadrados:corcheteCierra fin_o_falta
      {: parser.declararArreglo(nombre, "int", parser.tamanoTexto(tamano, parser.textoEntre(corcheteAbreleft, corcheteAbreright, corcheteCierraleft, corcheteCierraright)), 0, null, nombreleft, nombreright);
         parser.arreglo(nombre, "int", tamano, null, nombreleft, nombreright);
         parser.gen.declarar("int", nombre + "[" + tamano.lugar + "]"); :}
    | palabraVal FLOAT identificador:nombre abrir_corcheteCuadrados:corcheteAbre indice:tamano cerrar_corcheteCuadrados:corcheteCierra fin_o_falta
      {: parser.declararArreglo(nombre, "float", parser.tamanoTexto(tamano, parser.textoEntre(corcheteAbreleft, corcheteAbreright, corcheteCierraleft, corcheteCierraright)), 0, null, nombreleft, nombreright);
         parser.arreglo(nombre, "float", tamano, null, nombreleft, nombreright);
         parser.gen.declarar("float", nombre + "[" + tamano.lugar + "]"); :}
    | palabraVal BOOL identificador:nombre abrir_corcheteCuadrados indice cerrar_corcheteCuadrados fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "los arreglos solo pueden ser de tipo int o float, no bool ('" + nombre + "')");
         parser.declararArreglo(nombre, "error", null, 0, null, nombreleft, nombreright); :}
    | palabraVal CHAR identificador:nombre abrir_corcheteCuadrados indice cerrar_corcheteCuadrados fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "los arreglos solo pueden ser de tipo int o float, no char ('" + nombre + "')");
         parser.declararArreglo(nombre, "error", null, 0, null, nombreleft, nombreright); :}
    | palabraVal STRING identificador:nombre abrir_corcheteCuadrados indice cerrar_corcheteCuadrados fin_o_falta
      {: parser.errorProduccion(nombreleft, nombreright, "los arreglos solo pueden ser de tipo int o float, no string ('" + nombre + "')");
         parser.declararArreglo(nombre, "error", null, 0, null, nombreleft, nombreright); :}
    ;

/* Nombre: arreglo_con_tamano_valores
   Descripcion: crear un arreglo con su tamano y sus valores iniciales.
   Objetivo: guardarlo y revisar el tamano y los valores.
   Salida: ninguna. */
arreglo_con_tamano_valores ::=
      palabraVal INT   identificador:nombre abrir_corcheteCuadrados:corcheteAbre indice:tamano cerrar_corcheteCuadrados:corcheteCierra asignacion OPBLOCK:llaveAbre lista_arreglo:valores CLBLOCK:llaveCierra fin_o_falta
      {: parser.declararArreglo(nombre, "int", parser.tamanoTexto(tamano, parser.textoEntre(corcheteAbreleft, corcheteAbreright, corcheteCierraleft, corcheteCierraright)), valores.size(), "¿: " + parser.textoEntre(llaveAbreleft, llaveAbreright, llaveCierraleft, llaveCierraright) + " :?", nombreleft, nombreright);
         parser.gen.declararAntesDelValor("int", nombre + "[" + tamano.lugar + "]");
         parser.arreglo(nombre, "int", tamano, valores, nombreleft, nombreright);
         parser.generarValoresArreglo(nombre, "int", valores); :}
    | palabraVal FLOAT identificador:nombre abrir_corcheteCuadrados:corcheteAbre indice:tamano cerrar_corcheteCuadrados:corcheteCierra asignacion OPBLOCK:llaveAbre lista_arreglo:valores CLBLOCK:llaveCierra fin_o_falta
      {: parser.declararArreglo(nombre, "float", parser.tamanoTexto(tamano, parser.textoEntre(corcheteAbreleft, corcheteAbreright, corcheteCierraleft, corcheteCierraright)), valores.size(), "¿: " + parser.textoEntre(llaveAbreleft, llaveAbreright, llaveCierraleft, llaveCierraright) + " :?", nombreleft, nombreright);
         parser.gen.declararAntesDelValor("float", nombre + "[" + tamano.lugar + "]");
         parser.arreglo(nombre, "float", tamano, valores, nombreleft, nombreright);
         parser.generarValoresArreglo(nombre, "float", valores); :}
    ;

/* Nombre: arreglo_sin_tamano_valores
   Descripcion: crear un arreglo solo con sus valores iniciales.
   Objetivo: guardarlo y revisar los valores. El tamano es la cantidad de valores.
   Salida: ninguna. */
arreglo_sin_tamano_valores ::=
      palabraVal INT   identificador:nombre abrir_corcheteCuadrados cerrar_corcheteCuadrados asignacion OPBLOCK:llaveAbre lista_arreglo:valores CLBLOCK:llaveCierra fin_o_falta
      {: parser.declararArreglo(nombre, "int", null, valores.size(), "¿: " + parser.textoEntre(llaveAbreleft, llaveAbreright, llaveCierraleft, llaveCierraright) + " :?", nombreleft, nombreright);
         parser.gen.declararAntesDelValor("int", nombre + "[" + valores.size() + "]");
         parser.arreglo(nombre, "int", null, valores, nombreleft, nombreright);
         parser.generarValoresArreglo(nombre, "int", valores); :}
    | palabraVal FLOAT identificador:nombre abrir_corcheteCuadrados cerrar_corcheteCuadrados asignacion OPBLOCK:llaveAbre lista_arreglo:valores CLBLOCK:llaveCierra fin_o_falta
      {: parser.declararArreglo(nombre, "float", null, valores.size(), "¿: " + parser.textoEntre(llaveAbreleft, llaveAbreright, llaveCierraleft, llaveCierraright) + " :?", nombreleft, nombreright);
         parser.gen.declararAntesDelValor("float", nombre + "[" + valores.size() + "]");
         parser.arreglo(nombre, "float", null, valores, nombreleft, nombreright);
         parser.generarValoresArreglo(nombre, "float", valores); :}
    ;


/* Nombre: lista_arreglo, inicio_lista_arreglo y continuacion_lista_arreglo
   Descripcion: la lista de valores de un arreglo, separados por comas.
   Objetivo: juntar los valores en una lista, cada uno con su tipo.
   Salida: la lista de valores. */
lista_arreglo ::= inicio_lista_arreglo:lista  {: RESULT = lista; :} ;

inicio_lista_arreglo ::= expresion_aritmetica:valor continuacion_lista_arreglo:lista
                         {: lista.add(0, valor); RESULT = lista; :} ;

continuacion_lista_arreglo ::= coma expresion_aritmetica:valor continuacion_lista_arreglo:lista
                               {: lista.add(0, valor); RESULT = lista; :}
                             | /* vacio */  {: RESULT = new ArrayList(); :} ;

/* Nombre: modificacion_arreglo
   Descripcion: guardar un valor en una posicion de un arreglo, por ejemplo notas[0] = 5.
   Objetivo: revisar que el valor sea del tipo de los elementos y escribir la asignacion.
   Salida: ninguna. */
modificacion_arreglo ::= acceso_arreglo:elemento asignacion expresion:valor fin_o_falta
                         {: parser.asignar("Arreglos", elemento.lugar, elemento.tipo, valor, elementoleft, elementoright);
                            if (!elemento.tipo.equals("error")) { parser.generarAsignacion(elemento.lugar, elemento.tipo, valor); } :} ;


/* ============================================================
                OPERACIONES ARITMETICAS
   Orden de importancia (de mayor a menor): pot, + -, * / //, mod
   ============================================================ */

/* Nombre: operador_suma y operador_multiplicacion
   Descripcion: los simbolos + - y * / //.
   Objetivo: saber cual operador se uso.
   Salida: el simbolo como texto. */
operador_suma ::= PLUS   {: RESULT = "+"; :}
                | MINUS  {: RESULT = "-"; :} ;

operador_multiplicacion ::= MULTIPLY   {: RESULT = "*";  :}
                          | FLOATDIV   {: RESULT = "/";  :}
                          | ENTIREDIV  {: RESULT = "//"; :} ;

/* Nombre: expresion_aritmetica y sus niveles (mod, multiplicacion, suma)
   Descripcion: una operacion con numeros. Cada nivel respeta el orden de importancia.
   Objetivo: revisar y escribir cada operacion en el orden correcto.
   Salida: un dato con el tipo y el lugar del resultado. */
expresion_aritmetica ::= expresion_mod:valor  {: RESULT = valor; :} ;

expresion_mod ::= expresion_mod:izquierda MOD:simboloMod expresion_multiplicacion:derecha
                  {: RESULT = parser.generarAritmetica(izquierda, "mod", derecha, simboloModleft, simboloModright); :}
                | expresion_multiplicacion:valor  {: RESULT = valor; :} ;

expresion_multiplicacion ::= expresion_multiplicacion:izquierda operador_multiplicacion:operador expresion_suma:derecha
                             {: RESULT = parser.generarAritmetica(izquierda, operador, derecha, operadorleft, operadorright); :}
                           | expresion_suma:valor  {: RESULT = valor; :} ;

expresion_suma ::= expresion_suma:izquierda operador_suma:operador expresion_unaria:derecha
                   {: RESULT = parser.generarAritmetica(izquierda, operador, derecha, operadorleft, operadorright); :}
                 | expresion_unaria:valor  {: RESULT = valor; :} ;

/* Nombre: expresion_unaria
   Descripcion: un numero con signo menos, o una potencia.
   Objetivo: manejar los numeros negativos.
   Salida: un dato con el tipo y el valor. */
expresion_unaria ::= MINUS valor_numerico:numero  {: RESULT = parser.gen.cargar(parser.negativo(numero)); :}
                   | expresion_potencia:valor    {: RESULT = valor; :} ;

/* Nombre: expresion_potencia y exponente
   Descripcion: una potencia (pot) y su exponente.
   Objetivo: revisar y escribir la potencia. El exponente puede ser negativo para dar el error.
   Salida: un dato con el tipo y el lugar del resultado. */
expresion_potencia ::= valor_aritmetico:valor  {: RESULT = valor; :}
                     | valor_aritmetico:izquierda operadorPotencia:simboloPot exponente:derecha
                       {: RESULT = parser.generarAritmetica(izquierda, "pot", derecha, simboloPotleft, simboloPotright); :} ;

exponente ::= valor_aritmetico:valor        {: RESULT = valor; :}
            | MINUS valor_numerico:numero    {: RESULT = parser.negativo(numero); :} ;

/* Nombre: valor_aritmetico
   Descripcion: lo mas pequeno de una operacion: numero, variable, posicion de arreglo,
                llamada a funcion, texto, caracter o una operacion entre parentesis.
   Objetivo: dar el tipo y el lugar de ese valor. Si una variable no existe, queda de tipo error.
             Los numeros, textos, caracteres y variables se copian a un temporal (t1 = 5, t2 = x).
   Salida: un dato con su tipo y lugar. */
valor_aritmetico ::= valor_numerico:numero   {: RESULT = parser.gen.cargar(numero); :}
                   |  identificador:nombre
                    {: Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);
                        if (simbolo == null) { RESULT = new Atrib("error", nombre); }
                        else           { RESULT = parser.gen.cargar(new Atrib(simbolo.tipo, nombre)); } :}
                   | acceso_arreglo:elemento     {: RESULT = parser.generarElemento(elemento); :}
                   | llamada_funcion:llamada    {: RESULT = llamada; :}
                   | cadena_texto:texto       {: RESULT = parser.gen.cargar(texto); :}
                   | caracter_literal:caracter   {: RESULT = parser.gen.cargar(caracter); :}
                   | PARENOP expresion_aritmetica:valor PARENCL  {: RESULT = valor; :} ;

/* Nombre: operacion_incremento
   Descripcion: sumar o restar uno a una variable (x++ o x--).
   Objetivo: revisar que sea int o float.
   Salida: ninguna (escribe la instruccion si todo esta bien). */
operacion_incremento ::= identificador:nombre incremento
                         {: parser.incrementar(parser.usar(nombre, nombreleft, nombreright), nombre, "++", nombreleft, nombreright); :}
                       | identificador:nombre decremento
                         {: parser.incrementar(parser.usar(nombre, nombreleft, nombreright), nombre, "--", nombreleft, nombreright); :} ;


/* ============================================================
                OPERACIONES RELACIONALES
   ============================================================ */

/* Nombre: operadorRelacional
   Descripcion: los simbolos de comparar: < > <= >= == !=.
   Objetivo: saber cual comparacion se uso.
   Salida: el simbolo como texto. */
operadorRelacional ::= LT     {: RESULT = "<";  :}
                     | GT     {: RESULT = ">";  :}
                     | LTE    {: RESULT = "<="; :}
                     | GTE    {: RESULT = ">="; :}
                     | EQUAL  {: RESULT = "=="; :}
                     | NEQ    {: RESULT = "!="; :} ;

/* Nombre: operando_relacional
   Descripcion: cada lado de una comparacion. Puede ir con o sin corchetes.
   Objetivo: dar el tipo y el lugar de ese lado.
   Salida: un dato con su tipo y lugar. */
operando_relacional ::= valor_aritmetico:valor  {: RESULT = valor; :}
                      | bool:valorBool              {: RESULT = valorBool; :}
                      | abrir_corcheteCuadrados expresion:valor cerrar_corcheteCuadrados  {: RESULT = valor; :} ;

/* Nombre: operacion_relacional
   Descripcion: una comparacion entre dos valores.
   Objetivo: revisarla y escribir su instruccion.
   Salida: un dato de tipo bool. */
operacion_relacional ::= operando_relacional:izquierda operadorRelacional:operador operando_relacional:derecha
                         {: RESULT = parser.generarRelacional(izquierda, operador, derecha, operadorleft, operadorright); :} ;


/* ============================================================
                 EXPRESIONES LOGICAS
   ============================================================ */

/* Nombre: condicion_basica y operando_logico
   Descripcion: lo que puede ir a cada lado de un and, un or o un not.
   Objetivo: dar el tipo y el lugar de esa condicion.
   Salida: un dato con su tipo y lugar. */
condicion_basica ::= PARENOP operacion_relacional:comparacion PARENCL  {: RESULT = comparacion; :}
                   | PARENOP bool:valorBool PARENCL                  {: RESULT = valorBool; :}
                   | PARENOP condicion_basica:condicion PARENCL      {: RESULT = condicion; :}
                   | condiciones_logicas:condicion                   {: RESULT = condicion; :}
                   | negacion:negacion                              {: RESULT = negacion; :} ;

operando_logico ::= condicion_basica:condicion                       {: RESULT = condicion; :}
                  | PARENOP expresion_aritmetica:valor PARENCL   {: RESULT = valor; :} ;

/* Nombre: condiciones_and y condiciones_or
   Descripcion: varias condiciones unidas con and o con or.
   Objetivo: revisar cada union y escribir su instruccion.
   Salida: un dato de tipo bool. */
condiciones_and ::= operando_logico:izquierda AND:simboloLogico operando_logico:derecha
                    {: RESULT = parser.generarLogica(izquierda, "and", derecha, simboloLogicoleft, simboloLogicoright); :}
                  | condiciones_and:izquierda AND:simboloLogico operando_logico:derecha
                    {: RESULT = parser.generarLogica(izquierda, "and", derecha, simboloLogicoleft, simboloLogicoright); :} ;

condiciones_or ::= operando_logico:izquierda OR:simboloLogico operando_logico:derecha
                   {: RESULT = parser.generarLogica(izquierda, "or", derecha, simboloLogicoleft, simboloLogicoright); :}
                 | condiciones_and:izquierda OR:simboloLogico operando_logico:derecha
                   {: RESULT = parser.generarLogica(izquierda, "or", derecha, simboloLogicoleft, simboloLogicoright); :}
                 | operando_logico:izquierda OR:simboloLogico condiciones_and:derecha
                   {: RESULT = parser.generarLogica(izquierda, "or", derecha, simboloLogicoleft, simboloLogicoright); :}
                 | condiciones_and:izquierda OR:simboloLogico condiciones_and:derecha
                   {: RESULT = parser.generarLogica(izquierda, "or", derecha, simboloLogicoleft, simboloLogicoright); :}
                 | condiciones_or:izquierda OR:simboloLogico operando_logico:derecha
                   {: RESULT = parser.generarLogica(izquierda, "or", derecha, simboloLogicoleft, simboloLogicoright); :}
                 | condiciones_or:izquierda OR:simboloLogico condiciones_and:derecha
                   {: RESULT = parser.generarLogica(izquierda, "or", derecha, simboloLogicoleft, simboloLogicoright); :} ;

/* Nombre: condiciones_logicas
   Descripcion: una union de condiciones entre parentesis.
   Objetivo: poder agrupar condiciones.
   Salida: un dato de tipo bool. */
condiciones_logicas ::= PARENOP condiciones_and:condicion PARENCL  {: RESULT = condicion; :}
                      | PARENOP condiciones_or:condicion PARENCL   {: RESULT = condicion; :} ;

/* Nombre: negacion
   Descripcion: el operador not aplicado a una condicion.
   Objetivo: revisarlo y escribir su instruccion.
   Salida: un dato de tipo bool. */
negacion ::= NOT:simboloNot condicion_basica:condicion  {: RESULT = parser.generarNegacion(condicion, simboloNotleft, simboloNotright); :} ;

/* Nombre: expresion_logica
   Descripcion: una condicion con and, or o not.
   Objetivo: agrupar las expresiones logicas.
   Salida: un dato de tipo bool. */
expresion_logica ::= condiciones_and:condicion  {: RESULT = condicion; :}
                   | condiciones_or:condicion   {: RESULT = condicion; :}
                   | negacion:negacion         {: RESULT = negacion; :} ;

/* Nombre: condicion_control
   Descripcion: lo que se acepta como condicion de un if, elif o while.
   Objetivo: dar el tipo de la condicion. Luego se revisa que sea bool.
   Salida: un dato con su tipo y lugar. */
condicion_control ::= operacion_relacional:comparacion                   {: RESULT = comparacion; :}
                    | condiciones_and:condicion                        {: RESULT = condicion; :}
                    | condiciones_or:condicion                         {: RESULT = condicion; :}
                    | negacion:negacion                               {: RESULT = negacion; :}
                    | bool:valorBool                                   {: RESULT = valorBool; :}
                    | valor_aritmetico:valor                       {: RESULT = valor; :}
                    | PARENOP operacion_relacional:comparacion PARENCL   {: RESULT = comparacion; :}
                    | PARENOP bool:valorBool PARENCL                   {: RESULT = valorBool; :} ;


/* ============================================================
                EXPRESIONES Y FUNCIONES
   ============================================================ */

/* Nombre: expresion
   Descripcion: cualquier valor que se pueda calcular: operacion, comparacion, condicion o bool.
   Objetivo: agrupar todas las formas de expresion.
   Salida: un dato con su tipo y lugar. */
expresion ::= expresion_aritmetica:valor  {: RESULT = valor; :}
            | operacion_relacional:comparacion  {: RESULT = comparacion; :}
            | expresion_logica:condicion      {: RESULT = condicion; :}
            | bool:valorBool                  {: RESULT = valorBool; :} ;

/* Nombre: lista_expresiones y expresiones
   Descripcion: los datos que se dan al llamar una funcion, separados por comas.
   Objetivo: juntarlos en una lista, cada uno con su tipo.
   Salida: la lista de datos (puede estar vacia). */
lista_expresiones ::= /* vacio */  {: RESULT = new ArrayList(); :}
                    | expresiones:lista  {: RESULT = lista; :} ;

expresiones ::= expresion:valor
                {: ArrayList lista = new ArrayList(); lista.add(valor); RESULT = lista; :}
              | expresion:valor coma expresiones:lista
                {: lista.add(0, valor); RESULT = lista; :} ;

/* Nombre: llamada_funcion
   Descripcion: llamar a una funcion con sus datos.
   Objetivo: revisar que exista y que los datos sean correctos, y escribir la llamada.
   Salida: un dato con el tipo que devuelve la funcion. */
llamada_funcion ::= identificador:nombre PARENOP lista_expresiones:argumentos PARENCL
                    {: Simbolo funcion = parser.usarFuncion(nombre, nombreleft, nombreright);
                    RESULT = parser.generarLlamada(funcion, nombre, argumentos, nombreleft, nombreright); :} ;


/* ============================================================
                ESTRUCTURAS DE CONTROL
   ============================================================ */

/* Nombre: condicion_if
   Descripcion: la condicion de un if o de un elif, entre parentesis.
   Objetivo: revisar que sea de tipo bool y escribir sus saltos (al bloque si es verdadera,
             a la siguiente rama si es falsa). Si falta el parentesis final, lo pone y avisa.
   Salida: ninguna. */
condicion_if ::= PARENOP condicion_control:condicion cierra_paren
                 {: parser.condicion("Control", condicion, condicionleft, condicionright);
                    parser.gen.condicionIf(condicion.lugar); :} ;

/* Nombre: negacion_if
   Descripcion: la condicion de un if escrita con not y sin parentesis.
   Objetivo: escribir sus saltos igual que condicion_if.
   Salida: ninguna. */
negacion_if ::= negacion:condicion
                {: parser.gen.condicionIf(condicion.lugar); :} ;

/* Nombre: if, demas_if, fin_if, elif, cadena_elif y else
   Descripcion: la estructura if con sus elif y su else opcionales.
   Objetivo: reconocer la estructura. Si la condicion esta mal, salta hasta el bloque y sigue.
             Al terminar todo el if se escriben sus etiquetas pendientes.
   Salida: ninguna. */
if ::= palabraIf condicion_if abrir_bloque bloque cerrar_bloque demas_if
       {: parser.gen.finIf(); :}
     | palabraIf negacion_if abrir_bloque bloque cerrar_bloque demas_if
       {: parser.gen.finIf(); :}
     | palabraIf error abrir_bloque bloque cerrar_bloque demas_if
       {: parser.gen.finIf(); :} ;

demas_if ::= cadena_elif fin_if | fin_if ;

fin_if ::= else | /* vacio */ ;

elif ::= palabraElif condicion_if abrir_bloque bloque cerrar_bloque
       | palabraElif error abrir_bloque bloque cerrar_bloque ;

cadena_elif ::= elif | elif cadena_elif ;

else ::= palabraElse abrir_bloque bloque cerrar_bloque
       | palabraElse error abrir_bloque bloque cerrar_bloque ;

/* Nombre: condicion_while
   Descripcion: la condicion de un while, entre parentesis.
   Objetivo: revisar que sea bool, avisar que se entro a un ciclo (para el break)
             y escribir sus saltos (al bloque o al final).
   Salida: ninguna. */
condicion_while ::= PARENOP condicion_control:condicion cierra_paren
                    {: parser.condicion("Control", condicion, condicionleft, condicionright); parser.entrarCiclo();
                       parser.gen.saltoSiFalsoCiclo(condicion.lugar); :} ;

/* Nombre: ciclo_con_error
   Descripcion: una condicion de ciclo mal escrita.
   Objetivo: saltar el error y aun asi contar el ciclo.
   Salida: ninguna. */
ciclo_con_error ::= error {: parser.entrarCiclo(); :} ;

/* Nombre: while
   Descripcion: el ciclo while.
   Objetivo: reconocerlo, avisar cuando termina para el conteo de ciclos y escribir
             la vuelta a la condicion y la etiqueta de salida.
   Salida: ninguna. */
while ::= palabraWhile condicion_while abrir_bloque bloque cerrar_bloque
          {: parser.salirCiclo(); parser.gen.finCiclo(); :}
        | palabraWhile ciclo_con_error abrir_bloque bloque cerrar_bloque
          {: parser.salirCiclo(); parser.gen.finCiclo(); :}
        ;

/* Nombre: fin_init_for y fin_cond_for
   Descripcion: los dos simbolos de fin de sentencia dentro de la cabecera del for.
   Objetivo: marcar en el codigo intermedio donde termina la inicializacion (aqui va _cond)
             y donde termina la condicion (aqui empieza el incremento).
   Salida: ninguna. */
fin_init_for ::= TERMINATOR  {: parser.gen.inicioCondicionFor(); :} ;

fin_cond_for ::= TERMINATOR  {: parser.gen.marcaIncremento(); :} ;

/* Nombre: cabecera_for
   Descripcion: la parte entre parentesis de un for: inicio, condicion e incremento.
   Objetivo: revisar que la condicion sea bool, avisar que se entro a un ciclo y escribir
             los saltos de la condicion, la etiqueta _inc con su incremento y la etiqueta _bloque.
   Salida: ninguna. */
cabecera_for ::= PARENOP inicio_for fin_init_for condicion_for:condicion fin_cond_for incremento_for cierra_paren
                 {: parser.condicion("Control", condicion, condicionleft, condicionright); parser.entrarCiclo();
                    parser.gen.cabeceraFor(condicion == null ? null : condicion.lugar); :} ;

/* Nombre: for
   Descripcion: el ciclo for.
   Objetivo: reconocerlo y, al terminar, cerrar el bloque que abrio palabraFor.
             Tambien escribe la vuelta al incremento y la etiqueta de salida.
   Salida: ninguna. */
for ::= palabraFor cabecera_for abrir_bloque bloque cerrar_bloque
        {: parser.salirCiclo(); parser.tabla.cerrarAmbito(); parser.gen.finCiclo(); :}
      | palabraFor ciclo_con_error abrir_bloque bloque cerrar_bloque
        {: parser.salirCiclo(); parser.tabla.cerrarAmbito(); parser.gen.finCiclo(); :}
      ;

/* Nombre: inicio_for
   Descripcion: la primera parte del for: puede crear una variable o asignar una existente.
   Objetivo: revisar que el valor sea del tipo de la variable y escribir la asignacion.
   Salida: ninguna. */
inicio_for ::= /* vacio */
             | identificador:nombre asignacion expresion:valor
               {: Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);
                  if (simbolo != null) { parser.asignar("Control", nombre, simbolo.tipo, valor, nombreleft, nombreright);
                                         parser.generarAsignacion(nombre, simbolo.tipo, valor); } :}
             | palabraVal tipo:tipo identificador:nombre asignacion:signoAsigna expresion:valor
               {: parser.declararVariable(nombre, tipo, parser.textoDesde(signoAsignaleft, signoAsignaright), nombreleft, nombreright);
                  parser.asignar("Control", nombre, tipo, valor, nombreleft, nombreright);
                  parser.generarAsignacion(nombre, tipo, valor);
                  parser.gen.declararAntesDelValor(tipo, nombre); :}
             ;

/* Nombre: condicion_for
   Descripcion: la parte del medio del for: la condicion (puede ir vacia).
   Objetivo: dar su tipo para revisar que sea bool.
   Salida: un dato con su tipo, o null si va vacia. */
condicion_for ::= operacion_relacional:comparacion                  {: RESULT = comparacion; :}
                | expresion_logica:condicion                      {: RESULT = condicion; :}
                | bool:valorBool                                  {: RESULT = valorBool; :}
                | valor_aritmetico:valor                      {: RESULT = valor; :}
                | PARENOP operacion_relacional:comparacion PARENCL  {: RESULT = comparacion; :}
                | PARENOP bool:valorBool PARENCL                  {: RESULT = valorBool; :}
                | /* Vacio */                             {: RESULT = null; :}
                ;

/* Nombre: incremento_for
   Descripcion: la ultima parte del for: lo que se hace en cada vuelta.
   Objetivo: revisar que el valor sea del tipo de la variable y escribir la asignacion.
   Salida: ninguna. */
incremento_for ::= /* vacio */
                 | operacion_incremento
                 | expresion_aritmetica
                 | identificador:nombre asignacion expresion:valor
                   {: Simbolo simbolo = parser.usar(nombre, nombreleft, nombreright);
                      if (simbolo != null) { parser.asignar("Control", nombre, simbolo.tipo, valor, nombreleft, nombreright);
                                             parser.generarAsignacion(nombre, simbolo.tipo, valor); } :}
                 ;

/* Nombre: estructura_control
   Descripcion: un if, un while o un for.
   Objetivo: agrupar las estructuras de control.
   Salida: ninguna. */
estructura_control ::= if | while | for ;


/* ============================================================
                 SENTENCIAS Y BLOQUES
   ============================================================ */

/* Nombre: break
   Descripcion: la instruccion break.
   Objetivo: revisar que este dentro de un ciclo y escribir el salto a la salida del ciclo.
   Salida: ninguna. */
break ::= palabraBreak:palabra {: parser.validarBreak(palabraleft, palabraright);
                                  parser.gen.saltoBreak(); :} ;

/* Nombre: return
   Descripcion: la instruccion return, con valor o sin valor.
   Objetivo: revisar que el valor sea del tipo de la funcion.
   Salida: ninguna (escribe el return si todo esta bien). */
return ::= palabraReturn:palabraReturn fin_sentencia
           {: parser.retorno(null, palabraReturnleft, palabraReturnright); :}
         | palabraReturn:palabraReturn expresion:valor fin_o_falta
           {: parser.retorno(valor, palabraReturnleft, palabraReturnright); :} ;

/* Nombre: instruccion y sentencia_simple
   Descripcion: lo que puede ir dentro de un bloque: asignaciones, variables, arreglos,
                read, write, ++, --, llamadas, break, return o una estructura de control.
   Objetivo: agrupar todas las instrucciones. Si hay un error, salta hasta el fin de la sentencia.
   Salida: ninguna. */
instruccion ::= sentencia_simple | estructura_control ;

sentencia_simple ::=
      asignacion_variable
    | def_variable
    | creacion_arreglo
    | modificacion_arreglo
    | lectura
    | escritura
    | operacion_incremento
    | llamada_funcion fin_o_falta
    | break fin_o_falta
    | return
    | error fin_sentencia
    ;

/* Nombre: lista_instrucciones y bloque
   Descripcion: una o varias instrucciones, y el contenido de un bloque (puede estar vacio).
   Objetivo: armar el cuerpo de un bloque.
   Salida: ninguna. */
lista_instrucciones ::= instruccion | instruccion lista_instrucciones ;

bloque ::= /* vacio */ | lista_instrucciones ;


/* ============================================================
                       PARAMETROS
   ============================================================ */

/* Nombre: parametro
   Descripcion: un parametro de una funcion, con su tipo y su nombre.
   Objetivo: crear el simbolo del parametro. Si falta el tipo o es void, da un mensaje exacto.
   Salida: el simbolo del parametro. */
parametro ::= tipo:tipo identificador:nombre
              {: RESULT = new Simbolo(nombre, tipo, Simbolo.PARAMETRO, nombreleft, nombreright); :}
            | identificador:nombre
              {: parser.errorProduccion(nombreleft, nombreright, "falta el tipo del parámetro '" + nombre + "'");
                 RESULT = new Simbolo(nombre, "error", Simbolo.PARAMETRO, nombreleft, nombreright); :}
            | VOID identificador:nombre
              {: parser.errorProduccion(nombreleft, nombreright, "un parámetro no puede ser de tipo void ('" + nombre + "')");
                 RESULT = new Simbolo(nombre, "error", Simbolo.PARAMETRO, nombreleft, nombreright); :} ;

/* Nombre: lista_parametros y parametros
   Descripcion: todos los parametros de una funcion, separados por comas (puede no haber ninguno).
   Objetivo: juntarlos en una lista.
   Salida: la lista de parametros. */
lista_parametros ::= /* vacio */      {: RESULT = new ArrayList(); :}
                   | parametros:lista     {: RESULT = lista; :} ;

parametros ::= parametro:parametro
               {: ArrayList lista = new ArrayList(); lista.add(parametro); RESULT = lista; :}
             | parametro:parametro coma parametros:lista
               {: lista.add(0, parametro); RESULT = lista; :} ;


/* ============================================================
                        FUNCIONES
   ============================================================ */

/* Nombre: encabezado_funcion
   Descripcion: la primera linea de una funcion: tipo, nombre y parametros.
   Objetivo: guardar la funcion antes de leer su cuerpo (asi puede llamarse a si misma)
             y escribir su etiqueta (tipo_nombre) y sus parametros (param_int x).
   Salida: ninguna. */
encabezado_funcion ::= tipo:tipo identificador:nombre PARENOP lista_parametros:listaParametros cierra_paren
                        {: parser.declararFuncion(nombre, tipo, listaParametros, nombreleft, nombreright);
                           parser.gen.etiquetaFuncion(tipo, nombre);
                           for (Object elemento : listaParametros) {
                               Simbolo parametro = (Simbolo) elemento;
                               parser.gen.parametro(parametro.tipo, parametro.nombre);
                           } :} ;

/* Nombre: funcion_no_void
   Descripcion: una funcion que devuelve int, float, char o bool.
   Objetivo: leer su cuerpo, revisar que tenga al menos un return y escribir su
             etiqueta de fin (tipo_nombre_end).
   Salida: ninguna. */
funcion_no_void ::= encabezado_funcion abrir_bloque bloque cierra_bloque_fn
                    {: parser.finFuncion(); parser.gen.finFuncion(); :}
                  | tipo error abrir_bloque bloque cerrar_bloque ;

/* Nombre: funcion_void_invalida
   Descripcion: una funcion void con un nombre que no es principal.
   Objetivo: void solo es para principal, asi que es un error. Salta hasta el bloque y sigue.
   Salida: ninguna. */
funcion_void_invalida ::= VOID error abrir_bloque bloque cerrar_bloque ;


/* ============================================================
                        PRINCIPAL
   ============================================================ */

/* Nombre: principal
   Descripcion: la funcion principal, por donde empieza el programa.
   Objetivo: reconocerla y escribir su return y su etiqueta de fin (void_principal_end).
   Salida: ninguna. */
principal ::= VOID Principal PARENOP cierra_paren abrir_bloque bloque cierra_bloque_fn
                {: parser.gen.retorno(null); parser.gen.finFuncion(); :} ;


/* ============================================================
                  UNIDADES DEL PROGRAMA
   ============================================================ */

/* Nombre: unidades_programa y unidad
   Descripcion: las funciones y la principal, en cualquier orden.
   Objetivo: leer todas las partes del programa. Que exista una sola principal se revisa al final.
   Salida: ninguna. */
unidades_programa ::= /* vacio */
                    | unidad unidades_programa ;

unidad ::= funcion_no_void | principal | funcion_void_invalida ;


/* ============================================================
                        PROGRAMA
   ============================================================ */

/* Nombre: programa
   Descripcion: el programa completo: datos globales y luego funciones.
   Objetivo: al terminar, revisar que exista la funcion principal.
   Salida: ninguna. */
programa ::= lista_globales unidades_programa
            {: parser.finPrograma(); :} ;
